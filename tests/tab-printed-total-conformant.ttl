@prefix tab:  <https://w3id.org/iladub/tab#> .
@prefix dec:  <https://w3id.org/iladub/dec#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex:   <https://example.org/tab-demo#> .

# R261 spec § 4 positive: a printed total with its box, page, two operands, one table it
# totals, and the decision holon that admits it.
ex:pt a tab:PrintedTotal ;
    tab:cellText "374,904" ;
    tab:aggregates ex:c1 , ex:c2 ;
    tab:totalOf ex:tbl ;
    tab:hasBBox ex:bbox ;
    tab:onPage 3 .
ex:bbox a tab:BBox .
ex:tbl a tab:Table .

ex:d a dec:DecisionHolon ;
    rdfs:label "printed_total" ;
    dec:produced ex:pt ;
    dec:chosen ex:opt-total .
ex:opt-total rdfs:label "total" .
ex:opt-not-total rdfs:label "not_total" .
