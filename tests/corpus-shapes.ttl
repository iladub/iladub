# tests/corpus-shapes.ttl — membrane over the corpus register (spec 2026-08-02 §4).
# cor: is repo-internal (like dg:) — not published, not w3id-registered. The shape
# guards the REGISTER's integrity before a 3-minute compile trusts it; it never
# validates the corpus documents themselves. Closed-world constraint (§8 split).
@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix cor: <https://w3id.org/iladub/corpus#> .

cor:prefixes sh:declare [ sh:prefix "cor" ;
    sh:namespace "https://w3id.org/iladub/corpus#"^^xsd:anyURI ] .

cor:DocumentShape a sh:NodeShape ;
    sh:targetClass cor:Document ;
    sh:property [ sh:path cor:file ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cor:url ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cor:family ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ("ag-trade" "gov-stats" "financial" "health") ] ;
    sh:property [ sh:path cor:series ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cor:expectedVerdict ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in (cor:CompilesAbove cor:SemanticEscalation cor:Unadjudicated) ] ;
    sh:property [ sh:path cor:sha256 ; sh:maxCount 1 ;
                  sh:pattern "^[0-9a-f]{64}$" ] ;
    sh:property [ sh:path cor:scoreFloor ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ;
    sh:property [ sh:path cor:pages ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
    sh:property [ sh:path cor:contract ; sh:maxCount 1 ] ;
    sh:property [ sh:path cor:terms ; sh:maxCount 1 ] ;
    sh:property [ sh:path cor:shapes ; sh:maxCount 1 ] ;
    sh:sparql [
        sh:message "cor:CompilesAbove requires exactly one cor:scoreFloor" ;
        sh:prefixes cor:prefixes ;
        sh:select """SELECT $this WHERE {
            $this cor:expectedVerdict cor:CompilesAbove .
            FILTER NOT EXISTS { $this cor:scoreFloor ?f } }""" ] ;
    sh:sparql [
        sh:message "cor:SemanticEscalation requires cor:ambiguity naming it in prose" ;
        sh:prefixes cor:prefixes ;
        sh:select """SELECT $this WHERE {
            $this cor:expectedVerdict cor:SemanticEscalation .
            FILTER NOT EXISTS { $this cor:ambiguity ?a } }""" ] ;
    sh:sparql [
        sh:message "an adjudicated verdict requires a pinned edition (cor:sha256) and a recorded cor:adjudication" ;
        sh:prefixes cor:prefixes ;
        sh:select """SELECT $this WHERE {
            $this cor:expectedVerdict ?v .
            FILTER(?v != cor:Unadjudicated)
            FILTER(NOT EXISTS { $this cor:sha256 ?s } ||
                   NOT EXISTS { $this cor:adjudication ?a }) }""" ] ;
    sh:sparql [
        sh:message "cor:contract / cor:terms / cor:shapes travel together (all or none)" ;
        sh:prefixes cor:prefixes ;
        sh:select """SELECT $this WHERE {
            { $this cor:contract ?x } UNION { $this cor:terms ?x }
            UNION { $this cor:shapes ?x }
            FILTER(NOT EXISTS { $this cor:contract ?c } ||
                   NOT EXISTS { $this cor:terms ?t } ||
                   NOT EXISTS { $this cor:shapes ?p }) }""" ] .

# A reading is a dated measured value (vocab/internal/corpus.ttl § Readings). The shape
# is what makes the row traceable rather than merely present: exactly one value, at least
# one date it was measured on, and at least one of a commit or a path where it is
# transcribed — a number nobody can trace is not evidence, and this register's whole claim
# is that its figures can be checked rather than trusted.
cor:ReadingShape a sh:NodeShape ;
    sh:targetClass cor:Reading ;
    sh:property [ sh:path cor:value ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:decimal ] ;
    sh:property [ sh:path cor:readAt ; sh:minCount 1 ; sh:datatype xsd:date ] ;
    sh:property [ sh:path cor:notQuotable ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
    sh:sparql [
        sh:message "a reading must carry at least one of cor:atCommit / cor:recordedIn — an untraceable number is not evidence" ;
        sh:prefixes cor:prefixes ;
        sh:select """SELECT $this WHERE {
            $this a cor:Reading .
            FILTER(NOT EXISTS { $this cor:atCommit ?c } &&
                   NOT EXISTS { $this cor:recordedIn ?p }) }""" ] .

# A firing is a LIFTED fact (spec 2026-09-18 § 8): "reason R fired on this document, N times
# live and M superseded", read out of the committed corpus baseline and never authored in any
# tracked .ttl. Two counts, never one — a superseded firing is not a repaired one (§ 2.1) — so
# both are required and both are non-negative integers; a negative count is a lift defect.
# recordedIn makes it traceable to the baseline file it was lifted from (D1, closed world).
cor:FiringShape a sh:NodeShape ;
    sh:targetObjectsOf cor:firing ;
    sh:property [ sh:path cor:reason ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path cor:live ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:nonNegativeInteger ] ;
    sh:property [ sh:path cor:superseded ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:nonNegativeInteger ] ;
    sh:property [ sh:path cor:recordedIn ; sh:minCount 1 ] .

# A disposal is an AUTHORED judgement on a LIFTED fact, judged at the reading it was made
# against (spec 2026-10-19 § 4.4; R323 as ruled by the maintainer; supersedes the spec 2026-09-18
# § 3 D2 that judged against the CURRENT baseline). An adjudication may say cor:disposes "R" only
# if it names, by cor:judgedAgainst, exactly one cor:Snapshot -- a dated git blob of the baseline --
# and that snapshot (2) is of the document holding the adjudication, (3) is durable on main, and
# (4) carries a lifted cor:firing whose cor:reason is R with cor:live > 0. The current baseline
# plays no part: a disposal is append-only and a later repair of the cause must not unseat it.
# Four constraints, each with its own sh:message, so that a negative test can assert WHICH one
# refused. Constraints 2-4 bind the existing ?snap via `$this cor:judgedAgainst ?snap`; a disposal
# with none yields exactly constraint 1's refusal and nothing else.
# A reason that never fired, a misspelt one, one that fired only on another document, and one
# whose ink is all superseded (superseded is not repaired, spec 2026-09-18 § 2.1 -- there is
# nothing live to dispose of) are all refused by (4). Target is sh:targetSubjectsOf because
# adjudications are untyped blank nodes in the manifest, so a class target would never fire.
# The closed-world guards are HOLON-SCOPED: NOT EXISTS closes over the one document holding $this
# (2) or the one snapshot it names (4), never over the corpus.
# The reason join in (4) is SPARQL value equality (?reason = ?value), neither a shared variable
# nor STR(). Measured: rdflib keeps plain "R" and "R"^^xsd:string as DISTINCT terms (RDF 1.0
# behaviour), so a shared-variable join refuses "R"^^xsd:string against the lift's plain "R"
# although RDF 1.1 makes them one term; `=` admits both. STR() would go too far: "R"@en
# (rdf:langString) and "R"^^<other> are not equal under `=`, and are refused -- a reason code is
# a constant, not prose.
# Validated over manifest U lift_firings(...) U lift_snapshots(...): the manifest alone carries
# neither firings nor the snapshot facts (cor:snapshotOf, cor:durable, the snapshot's firings).
cor:DisposalShape a sh:NodeShape ;
    sh:targetSubjectsOf cor:disposes ;
    sh:property [ sh:path cor:judgedAgainst ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "cor:disposes without exactly one cor:judgedAgainst snapshot" ] ;
    sh:sparql [
        sh:message "cor:judgedAgainst names a snapshot of a different document than the one holding this adjudication" ;
        sh:prefixes cor:prefixes ;
        sh:select """SELECT $this ?snap WHERE {
            $this cor:judgedAgainst ?snap .
            FILTER NOT EXISTS {
                ?doc cor:adjudication $this .
                ?snap cor:snapshotOf ?doc } }""" ] ;
    sh:sparql [
        sh:message "cor:judgedAgainst names a snapshot that is not durable on main" ;
        sh:prefixes cor:prefixes ;
        sh:select """SELECT $this ?snap WHERE {
            $this cor:judgedAgainst ?snap .
            FILTER NOT EXISTS { ?snap cor:durable true } }""" ] ;
    sh:sparql [
        sh:message "cor:disposes names a reason with no LIVE cor:firing in the snapshot this adjudication was judged against" ;
        sh:prefixes cor:prefixes ;
        sh:select """SELECT $this ?value WHERE {
            $this cor:disposes ?value ;
                  cor:judgedAgainst ?snap .
            FILTER NOT EXISTS {
                ?snap cor:firing ?f .
                ?f cor:reason ?reason ;
                   cor:live ?n .
                FILTER(?reason = ?value && ?n > 0) } }""" ] .
