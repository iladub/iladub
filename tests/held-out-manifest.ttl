# tests/held-out-manifest.ttl — the HELD-OUT document register (2026-10-06).
# Same cor: fields as tests/corpus-manifest.ttl, and deliberately a different file: every
# cor:Document in the corpus register must map one-to-one onto an etkl criterion
# (tests/test_arc_manifest.py::test_etkl_criteria_agree_with_the_corpus_manifest), so a document
# measured here would become a benchmark row there. Nothing that computes the benchmark parses
# this file. Documents are FETCHED into held-out/ (gitignored, outside corpus/), never committed:
#     .venv/bin/python scripts/fetch_corpus.py tests/held-out-manifest.ttl held-out
# Selection, prediction and readings: docs/superpowers/2026-10-06-held-out-corpus.md.
# cor:Unadjudicated throughout: a held-out reading is a measurement, not an acceptance.
@prefix cor: <https://w3id.org/iladub/corpus#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:iladub:held-out:fed-h41-2025-01-02> a cor:Document ;
    cor:file "fed-h41-2025-01-02.pdf" ;
    cor:url "https://www.federalreserve.gov/releases/h41/20250102/h41.pdf" ;
    cor:family "financial" ;
    cor:series "fed-h41" ;
    cor:producer "Aspose.Words for .NET 21.3.0" ;
    cor:fetched "2026-10-06"^^xsd:date ;
    cor:sha256 "51273fa7646de7f1af281943d1a7ea3e1ea2f71bf5ca4503e27c02275be522e1" ;
    cor:pages 11 ;
    cor:expectedVerdict cor:Unadjudicated .

<urn:iladub:held-out:arxiv-1706.03762v7> a cor:Document ;
    cor:file "arxiv-1706.03762v7.pdf" ;
    cor:url "https://arxiv.org/pdf/1706.03762v7" ;
    cor:family "scientific" ;
    cor:series "arxiv-paper" ;
