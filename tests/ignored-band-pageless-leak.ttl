@prefix etkl:   <https://w3id.org/iladub/etkl#> .
@prefix iladub: <https://w3id.org/iladub#> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix ex:     <https://example.org/demo#> .

#  NON-CONFORMANT: a carried ignored band whose source region carries NO page.
#  Provenance to the page (CLAUDE.md §6) is reached from the band through
#  iladub:fromRegion / iladub:onPage, and a region with no page is the stub that
#  requirement exists to prevent (escalate_region's docstring, holon.py, records
#  the same argument for a candidate's region).
#  Exactly one thing is removed from examples/ignored-band-conformant.ttl.

ex:capacity-doc-p0-ignored1 a etkl:IgnoredBand ;
    etkl:bandText "ELEVATION CAPACITY TABLE\nAs At Tuesday, 4 August 2026" ;
    etkl:bandIndex 1 ;
    etkl:ignoredBecause "fewer than 2 columns" ;
    iladub:fromRegion ex:capacity-doc-p0-ignored1-source ;
    prov:wasDerivedFrom ex:capacity-doc-p0 .

ex:capacity-doc-p0-ignored1-source a iladub:SourceRegion ;
    prov:wasDerivedFrom ex:capacity-doc-p0 .
