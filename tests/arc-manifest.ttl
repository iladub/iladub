prog:criterion:etkl:05 a prog:Criterion ;
    prog:ofRung "etkl" ;
    prog:statement "gov-stats/bfs-population-bilan-2023.pdf: this document compiles via compile_document to cor:CompilesAbove with a pinned cor:scoreFloor, under a cor:adjudication whose rationale accepts that score — not one that holds it." ;
    prog:source "tests/corpus-manifest.ttl:92" ;
