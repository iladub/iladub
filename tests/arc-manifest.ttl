# `met false` MEASURED 2026-08-20:
#   $ grep -rln "CleanDocumentHolon" examples/
#     (no output — no example carries one at all)
#   $ grep -rln "RawDocumentHolon" examples/ tests/ vocab/
#     examples/transplant/offer.databook.md  (one line of PROSE, not a traversal)
