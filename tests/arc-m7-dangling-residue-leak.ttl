@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix prog: <https://w3id.org/iladub/progress#> .

# M7: a prog:blockedBy naming a residue row that is not in the register index. A
# dangling edge is worse than no edge — it reads as strategy and points at nothing.
# SHACL-clean by design: the register is a markdown file the graph cannot see.
prog:criterion:tab:matrix-ambiguous a prog:Criterion ;
    prog:ofRung "tab" ;
    prog:statement "MATRIX_AMBIGUOUS either does not fire on the corpus, or every occurrence is adjudicated." ;
    prog:source "docs/superpowers/specs/2026-08-20-the-arc-has-a-denominator-design.md:423-424" ;
    prog:declaredOn "2026-08-01"^^xsd:date ;
    prog:met false ;
    prog:retrospective false ;
    prog:blockedBy "R999" .
