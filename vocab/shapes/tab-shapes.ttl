@prefix tab:  <https://w3id.org/iladub/tab#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

tab:prefixes
    sh:declare [ sh:prefix "tab" ; sh:namespace "https://w3id.org/iladub/tab#"^^xsd:anyURI ] .

#################################################################
#  Coverage: every leaf column that belongs to a table must be
#  covered by at least one header node.
#################################################################

tab:CoverageShape a sh:NodeShape ;
    sh:targetClass tab:LeafColumn ;
    sh:sparql [
        sh:message "Leaf column is not covered by any header node of its table (coverage gap)." ;
        sh:prefixes tab:prefixes ;
        sh:select """
            SELECT $this WHERE {
                ?tbl tab:hasLeafColumn $this .
                FILTER NOT EXISTS {
                    ?tbl tab:hasHeaderNode ?h .
                    ?h tab:coversColumn $this
                }
            }
        """ ] .

#################################################################
#  No-overlap: two distinct header nodes at the SAME level must
#  not cover the same leaf column.
#
#  Targets subjects of tab:hasHeaderNode so this works for any
#  table subclass without needing the ontology loaded in the data
#  graph for RDFS subclass inference.
#################################################################

tab:NoOverlapShape a sh:NodeShape ;
    sh:targetSubjectsOf tab:hasHeaderNode ;
    sh:sparql [
        sh:message "Two header nodes at the same level cover the same column (overlap)." ;
        sh:prefixes tab:prefixes ;
        sh:select """
            SELECT $this WHERE {
                $this tab:hasHeaderNode ?h1 .
                $this tab:hasHeaderNode ?h2 .
                FILTER(str(?h1) < str(?h2))
                ?h1 tab:headerLevel ?l .
                ?h2 tab:headerLevel ?l .
                ?h1 tab:coversColumn ?c .
                ?h2 tab:coversColumn ?c .
            }
        """ ] .

#################################################################
#  Refinement: a child header's covered columns must be a subset
#  of its parent's covered columns.
#################################################################

tab:RefinementShape a sh:NodeShape ;
    sh:targetClass tab:HeaderNode ;
    sh:sparql [
        sh:message "A header node covers a column its parent does not (refinement break)." ;
        sh:prefixes tab:prefixes ;
        sh:select """
            SELECT $this WHERE {
                $this tab:parentHeader ?p .
                $this tab:coversColumn ?c .
                FILTER NOT EXISTS { ?p tab:coversColumn ?c }
            }
        """ ] .

#################################################################
#  Access cardinality: an entry cell has exactly one column and
#  one row.
#################################################################

tab:EntryCellShape a sh:NodeShape ;
    sh:targetClass tab:EntryCell ;
    sh:property [ sh:name "EntryCellShape" ; sh:path tab:atColumn ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "An entry cell must sit at exactly one leaf column." ] ;
    sh:property [ sh:name "EntryCellShape" ; sh:path tab:atRow ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "An entry cell must sit at exactly one leaf row." ] .

#################################################################
#  Orphan guard: an entry cell's column must be a leaf column of
#  the table that owns the cell.
#################################################################

tab:EntryColumnBoundShape a sh:NodeShape ;
    sh:targetClass tab:EntryCell ;
    sh:sparql [
        sh:message "Entry cell sits at a column that is not a leaf column of its table (orphan)." ;
        sh:prefixes tab:prefixes ;
        sh:select """
            SELECT $this WHERE {
                ?tbl tab:hasCell $this .
                $this tab:atColumn ?c .
                FILTER NOT EXISTS { ?tbl tab:hasLeafColumn ?c }
            }
        """ ] .

#################################################################
#  Orphan guard (row): an entry cell's row must be a leaf row
#  of the table that owns the cell.
#################################################################

tab:EntryRowBoundShape a sh:NodeShape ;
    sh:targetClass tab:EntryCell ;
    sh:sparql [
        sh:message "Entry cell sits at a row that is not a leaf row of its table (orphan row)." ;
        sh:prefixes tab:prefixes ;
        sh:select """
            SELECT $this WHERE {
                ?tbl tab:hasCell $this .
                $this tab:atRow ?r .
                FILTER NOT EXISTS { ?tbl tab:hasLeafRow ?r }
            }
        """ ] .

#################################################################
#  Unambiguous column path: each leaf column is covered by
#  exactly one LEAF header of its own table (a header with no
#  children). Zero or two+ => ambiguous / undefined path.
#################################################################

tab:UnambiguousAccessShape a sh:NodeShape ;
    sh:targetClass tab:LeafColumn ;
    sh:sparql [
        sh:message "Leaf column does not have exactly one leaf-header of its table (ambiguous column path)." ;
        sh:prefixes tab:prefixes ;
        sh:select """
            SELECT $this WHERE {
                ?tbl tab:hasLeafColumn $this .
                {
                    SELECT ?tbl $this (COUNT(DISTINCT ?h) AS ?n) WHERE {
                        ?tbl tab:hasLeafColumn $this .
                        OPTIONAL {
                            ?tbl tab:hasHeaderNode ?h .
                            ?h tab:coversColumn $this .
                            FILTER NOT EXISTS { ?child tab:parentHeader ?h }
                        }
                    } GROUP BY ?tbl $this
                }
                FILTER(?n != 1)
            }
        """ ] .

#################################################################
#  Row-axis mirror of the column tiling invariants. Coverage and
#  UnambiguousRowAccess are GUARDED to fire only for tables that
#  have a row axis (>=1 coversRow), so flat/column-only tables
#  (leaf rows, no row-headers) still pass.
#################################################################

tab:RowCoverageShape a sh:NodeShape ;
    sh:targetClass tab:LeafRow ;
    sh:sparql [
        sh:message "Leaf row is not covered by any row-header of its table (row coverage gap; derived-only trees are exempt — they are partial annotations)." ;
        sh:prefixes tab:prefixes ;
        sh:select """
            SELECT $this WHERE {
                ?tbl tab:hasLeafRow $this .
                FILTER EXISTS { ?tbl tab:hasHeaderNode ?any . ?any tab:coversRow ?anyrow .
                                FILTER NOT EXISTS { ?any a tab:DerivedRowGroup } }
                FILTER NOT EXISTS { ?tbl tab:hasHeaderNode ?h . ?h tab:coversRow $this }
            }
        """ ] .

tab:RowNoOverlapShape a sh:NodeShape ;
    sh:targetSubjectsOf tab:hasHeaderNode ;
    sh:sparql [
        sh:message "Two header nodes at the same level cover the same row (row overlap; any pair involving a derived row group is exempt — a derived group is a carried annotation, not a claimed partition, and row-group-nesting.rq rightly refuses to link groups with identical member sets, leaving them co-resident at level 0)." ;
        sh:prefixes tab:prefixes ;
        sh:select """
            SELECT $this WHERE {
                $this tab:hasHeaderNode ?h1 .
                $this tab:hasHeaderNode ?h2 .
                FILTER(str(?h1) < str(?h2))
                ?h1 tab:headerLevel ?l .
                ?h2 tab:headerLevel ?l .
                ?h1 tab:coversRow ?r .
                ?h2 tab:coversRow ?r .
                FILTER NOT EXISTS { ?h1 a tab:DerivedRowGroup }
                FILTER NOT EXISTS { ?h2 a tab:DerivedRowGroup }
            }
        """ ] .

tab:RowRefinementShape a sh:NodeShape ;
    sh:targetClass tab:HeaderNode ;
    sh:sparql [
        sh:message "A header node covers a row its parent does not (row refinement break)." ;
        sh:prefixes tab:prefixes ;
        sh:select """
            SELECT $this WHERE {
                $this tab:parentHeader ?p .
                $this tab:coversRow ?r .
                FILTER NOT EXISTS { ?p tab:coversRow ?r }
            }
        """ ] .

tab:PivotedDimensionShape a sh:NodeShape ;
    sh:targetClass tab:PivotedDimension ;
    sh:property [ sh:path tab:hasDimensionValue ; sh:minCount 1 ;
                  sh:message "A pivoted dimension needs at least one value." ] ;
    sh:property [ sh:path tab:onAxis ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:message "A pivoted dimension sits on exactly one axis." ] .

tab:UnambiguousRowAccessShape a sh:NodeShape ;
    sh:targetClass tab:LeafRow ;
    sh:sparql [
        sh:message "Leaf row does not have exactly one leaf-header of its table (ambiguous row path)." ;
        sh:prefixes tab:prefixes ;
        sh:select """
            SELECT $this WHERE {
                ?tbl tab:hasLeafRow $this .
                FILTER EXISTS { ?tbl tab:hasHeaderNode ?any . ?any tab:coversRow ?anyrow .
                                FILTER NOT EXISTS { ?any a tab:DerivedRowGroup } }
                {
                    SELECT ?tbl $this (COUNT(DISTINCT ?h) AS ?n) WHERE {
                        ?tbl tab:hasLeafRow $this .
                        OPTIONAL {
                            ?tbl tab:hasHeaderNode ?h .
                            ?h tab:coversRow $this .
                            FILTER NOT EXISTS { ?child tab:parentHeader ?h }
                            FILTER NOT EXISTS { ?h a tab:DerivedRowGroup }
                        }
                    } GROUP BY ?tbl $this
                }
                FILTER(?n != 1)
            }
        """ ] .

#################################################################
#  Aggregation cell: must declare the function it applies, at
#  least one operand cell, and at least one axis it runs along.
#################################################################

tab:AggregationCellShape a sh:NodeShape ;
    sh:targetClass tab:AggregationCell ;
    sh:property [ sh:path tab:aggregationFunction ; sh:minCount 1 ;
                  sh:message "An aggregation cell needs an aggregationFunction." ] ;
    sh:property [ sh:path tab:aggregates ; sh:minCount 1 ;
                  sh:message "An aggregation cell needs at least one operand." ] ;
    sh:property [ sh:path tab:overAxis ; sh:minCount 1 ;
                  sh:message "An aggregation cell needs at least one overAxis." ] .

tab:BaseFactShape a sh:NodeShape ;
    sh:targetClass tab:BaseFact ;
    sh:property [ sh:path tab:measureValue ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:message "A base fact has exactly one measureValue." ] ;
    sh:property [ sh:path tab:atDimensionValue ; sh:minCount 1 ;
                  sh:message "A base fact has at least one dimension coordinate." ] .

#################################################################
#  Content conservation (loop C oracle 2): every header-region
#  source cell must be accounted for — either merged into an
#  asserted header label, or carried as a region caption. What this
#  refuses is a header-region source cell whose text appears in NO
#  asserted header label and NO region caption — a reading that
#  genuinely LOSES a word.
#
#  An all-furniture reading is LEGAL BY DESIGN: every source cell is
#  carried as a tab:RegionCaption, so nothing is lost and this shape
#  conforms. Ranking two legal readings (e.g. furniture vs.
#  continuation for the same row) is NOT this shape's job — that
#  choice is irreducibly NEURAL (see rowrole.py's module docstring
#  and spec §2 Finding 5); this shape only refuses genuine loss.
#
#  Graph-scoped, not ?tbl-scoped, on purpose: region_tiles is
#  invoked on a fresh scratch graph holding ONE candidate region,
#  so the graph IS the holon — the region is the closure boundary.
#
#  Known weaknesses (stated, not hidden):
#  - False-pass: CONTAINS can let a lost word pass if it
#    coincidentally occurs inside another label. It cannot pass a
#    word absent from every label and every caption.
#  - False-refuse: CONTAINS is case-sensitive, so text conserved
#    with different casing than its source (e.g. "unit" carried as
#    "Unit") would be reported as lost even though nothing was
#    dropped. Nothing in the pipeline case-normalises header text
#    today. This errs toward honest escalation rather than silent
#    loss (CLAUDE.md §7), but it is not exact.
#################################################################

tab:HeaderContentConservedShape a sh:NodeShape ;
    sh:targetClass tab:HeaderSourceCell ;
    sh:sparql [
        sh:message "Header-region source cell is not accounted for: neither merged into an asserted header label nor carried as a region caption." ;
        sh:prefixes tab:prefixes ;
        sh:select """
            SELECT $this WHERE {
                $this tab:sourceText ?txt .
                FILTER NOT EXISTS { ?lc a tab:LabelCell ; tab:cellText ?lt . FILTER(CONTAINS(?lt, ?txt)) }
                FILTER NOT EXISTS { ?cap a tab:RegionCaption ; tab:captionText ?ct . FILTER(CONTAINS(?ct, ?txt)) }
            }
        """ ] .

#################################################################
#  Detected aggregation rows (loop H): a row CLAIMED as a
#  detected aggregation must carry its evidence — operands and
#  the function. Targets the SUBCLASS only: denormalization's
#  reshape path types rows bare tab:AggregationRow with cell-level
#  operands, and must not be judged by this shape.
#################################################################

tab:DetectedAggregationRowShape a sh:NodeShape ;
    sh:targetClass tab:DetectedAggregationRow ;
    sh:property [ sh:path tab:aggregates ; sh:minCount 1 ;
                  sh:message "A detected aggregation row needs at least one operand row." ] ;
    sh:property [ sh:path tab:aggregationFunction ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:message "A detected aggregation row needs exactly one aggregationFunction." ] .

#################################################################
#  Section totals (loop Q): a row CLAIMED as a confirmed
#  per-section total must name exactly the one section table its
#  arithmetic confirmed — a SectionTotal typing without its
#  tab:confirmsSection witness (or with two) is a contradiction of
#  the term's own definition (typed only where the section-scoped
#  exact arithmetic confirmed, one section per total row).
#################################################################

tab:SectionTotalShape a sh:NodeShape ;
    sh:targetClass tab:SectionTotal ;
    sh:property [ sh:path tab:confirmsSection ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:message "A confirmed section total names exactly one section table it confirms." ] .

#################################################################
#  Derived row groups (loop I): a derived group must be
#  explained — one label (the source key cell), at least one
#  member, and its witnessing aggregation row. Targets the
#  SUBCLASS only: authored HeaderNodes are untouched.
#################################################################

tab:DerivedRowGroupShape a sh:NodeShape ;
    sh:targetClass tab:DerivedRowGroup ;
    sh:property [ sh:name "DerivedRowGroupShape" ; sh:path tab:hasLabel ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A derived row group needs exactly one label (its source key cell)." ] ;
    sh:property [ sh:name "DerivedRowGroupShape" ; sh:path tab:coversRow ; sh:minCount 1 ;
        sh:message "A derived row group needs at least one member row." ] ;
    sh:property [ sh:name "DerivedRowGroupShape" ; sh:path prov:wasDerivedFrom ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A derived row group needs exactly one witnessing aggregation row." ] ;
    sh:property [ sh:name "DerivedRowGroupShape" ; sh:path tab:parentHeader ; sh:maxCount 1 ;
        sh:message "A derived row group has at most one parent." ] .

#################################################################
#  Cross-table membrane discipline (loop N task 4): the two
#  document-level correspondence terms, membrane-checked at the
#  whole-graph pass (compile.py's per-page validation cannot see
#  them — they are asserted AFTER pages merge). Both shapes check
#  a WITNESSED licence, never a totality: an ordinary unchained
#  column carries NEITHER edge at all, and that absence is the
#  correct, honest state (see tab.ttl's tab:inLogicalColumn
#  comment, corrected the same loop for the identical reason).
#  THE PRINCIPLE, stated once for both: the logical table is the
#  closure holon (spec §2b/§8) — these edges are what lets a
#  derivation (the row-group key, the arithmetic re-run) treat a
#  continuation chain as one table, so a FABRICATED edge would
#  silently let one derivation read a cell that was never licensed
#  to stand for another. The shapes below refuse exactly that,
#  and nothing more.
#################################################################

tab:ContinuesColumnDisciplineShape a sh:NodeShape ;
    sh:targetSubjectsOf tab:continuesColumn ;
    sh:sparql [
        sh:message "tab:continuesColumn is asserted between two columns whose owning tables are not linked by tab:continuesTable (the SAME licence the column edge rides on)." ;
        sh:prefixes tab:prefixes ;
        sh:select """
            SELECT $this WHERE {
                $this tab:continuesColumn ?prev .
                ?curTbl tab:hasLeafColumn $this .
                ?prevTbl tab:hasLeafColumn ?prev .
                FILTER NOT EXISTS { ?curTbl tab:continuesTable ?prevTbl }
            }
        """ ] .

# THE LICENCE'S TWO VERDICTS ARE EXCLUSIVE (loop O, R33). A recognized page pair is either
# STITCHED (tab:continuesTable, the licence held) or REFUSED (tab:licenceRefused, it did not) —
# never both, in either direction. The graph would otherwise state that one pair of tables is
# both one logical table and two independent ones, and every consumer of a chain (the arithmetic
# window, the row-group key, the feed's chain walk) would be free to pick the reading it liked.
tab:LicenceRefusalShape a sh:NodeShape ;
    sh:targetSubjectsOf tab:licenceRefused ;
    sh:sparql [
        sh:message "A table pair is linked by BOTH tab:licenceRefused and tab:continuesTable — the continuation licence's two verdicts are exclusive over one recognized pair." ;
        sh:prefixes tab:prefixes ;
        sh:select """
            SELECT $this WHERE {
                $this tab:licenceRefused ?prev .
                { $this tab:continuesTable ?prev } UNION { ?prev tab:continuesTable $this }
            }
        """ ] .

tab:InLogicalColumnDisciplineShape a sh:NodeShape ;
    sh:targetSubjectsOf tab:inLogicalColumn ;
    sh:sparql [
        sh:message "tab:inLogicalColumn is asserted without either a tab:continuesColumn+ path to its object or a genuine reflexive licence (some column actually continues THIS one) — a fabricated logical-column claim, not the materialized closure." ;
        sh:prefixes tab:prefixes ;
        sh:select """
            SELECT $this WHERE {
                $this tab:inLogicalColumn ?y .
                FILTER NOT EXISTS { $this tab:continuesColumn+ ?y }
                FILTER( !(sameTerm($this, ?y)) || NOT EXISTS { ?z tab:continuesColumn $this } )
            }
        """ ] .
