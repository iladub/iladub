@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix tab:  <https://w3id.org/iladub/tab#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://w3id.org/iladub/tab/shapes/physical> a <http://www.w3.org/2002/07/owl#Ontology> ;
    dcterms:title "tab physical-layer SHACL shapes"@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:creator "François Rosselet" .

# An asserted EntryCell must carry its measured geometry and surface text —
# so the holon can be round-tripped and traced to the page (provenance-to-page).
tab:EntryCellPhysicalShape a sh:NodeShape ;
    sh:targetClass tab:EntryCell ;
    sh:property [ sh:name "EntryCellPhysicalShape" ; sh:path tab:cellText ; sh:minCount 1 ] ;
    sh:property [ sh:name "EntryCellPhysicalShape" ; sh:path tab:onPage ;
                  sh:minCount 1 ; sh:datatype xsd:integer ] ;
    sh:property [ sh:name "EntryCellPhysicalShape" ; sh:path tab:hasBBox ;
                  sh:minCount 1 ; sh:class tab:BBox ] .

# A carried cell that has measured geometry (hasBBox) must also carry its
# surface text — wrapped physical lines are merged into one cell before
# assertion, so a textless bbox-carrying cell signals a dropped continuation.
# This constraint fires ONLY when hasBBox is present (conditional via SPARQL)
# so topology-only Cell instances without bbox are not affected.
tab:WrappedCellShape a sh:NodeShape ;
    sh:targetClass tab:Cell ;
    sh:property [ sh:name "WrappedCellShape" ; sh:path tab:hasBBox ; sh:maxCount 1 ] ;
    sh:sparql [
        sh:name "WrappedCellShape" ;
        sh:message "A tab:Cell with a hasBBox must have non-empty cellText (drop-continuation guard)." ;
        sh:select """
            PREFIX tab: <https://w3id.org/iladub/tab#>
            SELECT $this WHERE {
                $this tab:hasBBox ?bbox .
                FILTER NOT EXISTS {
                    $this tab:cellText ?t .
                    FILTER(strlen(str(?t)) > 0)
                }
            }
        """ ;
    ] .

# A header LabelCell that carries surface TEXT must carry its location too — the exact
# converse of tab:WrappedCellShape above (bbox => text), so text and geometry are
# co-present on a label in both directions (provenance-to-the-page, R179 / R177).
#
# Conditional on the label's OWN non-empty cellText, and NOT on "the header node it labels
# carries geometry": no tab:HeaderNode carries geometry in any emitted graph, so that
# condition is not expressible in SHACL. Over the emitting tree the two predicates select
# the same single node — span.build_reading's flank filler, HeaderNode(0, (flank,), "", None),
# minted for a column with no header ink at all. That node is honestly boxless and stays
# exempt: refusing it would infer from absence, which the ink never supported.
#
# The two halves are SEPARATE constraints so a violation names which one is missing; a merged
# constraint hides the onPage half behind the bbox half.
#
# Both constraints EXCLUDE a cell that is also a tab:EntryCell, and that exclusion is provably
# lossless: tab:EntryCellPhysicalShape above already requires cellText + onPage + hasBBox of
# every entry, unconditionally -- strictly more than this shape asks. It is there because
# tab:hasLabel has rdfs:range tab:LabelCell and rowgroups.py:93 points it at the SOURCE
# EntryCell carrying a derived group's label (that module's own docstring says so). Under a
# closure that materialises range typing, that entry becomes a tab:LabelCell and this shape
# would target it -- the R19 accident (subclass_closure's docstring in membrane.py records why
# domain/range typing was dropped from the production closure). Measured 2026-09-07: without
# this filter, test_closure_equiv.py::test_both_closures_agree_on_a_mutated_real_page_graph
# FAILS -- full closure reports one extra SPARQLConstraintComponent on htable2-e0_0 that the
# subclass-only closure does not. The filter makes the shape say the same thing under both.
#
# THAT PREMISE WAS REMOVED AT ITS ROOT BY R61 (2026-09-08). tab:hasLabel now has rdfs:range
# tab:Cell, not tab:LabelCell, precisely because deriving LabelCell on those 18 corpus EntryCells
# was a false assertion in a published graph. So the range no longer types an entry as a label
# under ANY closure, and the 2026-09-07 measurement above no longer reproduces: RE-RUN with both
# filters deleted, test_closure_equiv.py is 18 passed in 81.74s. The filter is now inert on the
# corpus, and it is KEPT anyway, under CLAUDE.md § Producer-side guards vs the membrane -- the
# condition for deleting a guard is PROVABLE total coverage, and nothing prevents a future emitter
# from typing one node both tab:LabelCell and tab:EntryCell explicitly.
#
# AND R61 ANSWERED THE QUESTION R61's ROW ASKED. The row wanted this filter pinned as
# load-bearing. It CANNOT be, and the attempted falsification is what showed why: construct the
# both-typed node with cellText and no geometry, and the only shape that refuses it is
# tab:EntryCellPhysicalShape -- deleting this filter changes the verdict not at all. The exclusion
# is LOSSLESS BY DOMINATION, exactly as the paragraph above claims and as nobody had measured: the
# entry shape asks for strictly more, so exempting a both-typed cell here can never hide a defect.
# A test asserting "delete the filter and the shape refuses" would have pinned the ENTRY shape
# while claiming to pin this one. test_domain_range_agreement.py pins the domination instead.
tab:LabelCellPhysicalShape a sh:NodeShape ;
    sh:targetClass tab:LabelCell ;
    sh:property [ sh:name "LabelCellPhysicalShape" ; sh:path tab:hasBBox ; sh:maxCount 1 ] ;
    sh:property [ sh:name "LabelCellPhysicalShape" ; sh:path tab:onPage ;
                  sh:maxCount 1 ; sh:datatype xsd:integer ] ;
    sh:sparql [
        sh:name "LabelCellPhysicalShape" ;
        sh:message "A tab:LabelCell with non-empty cellText must carry a tab:hasBBox (provenance-to-the-page)." ;
        sh:select """
            PREFIX tab: <https://w3id.org/iladub/tab#>
            SELECT $this WHERE {
                $this tab:cellText ?t .
                FILTER(strlen(str(?t)) > 0)
                FILTER NOT EXISTS { $this a tab:EntryCell }
                FILTER NOT EXISTS { $this tab:hasBBox ?bbox }
            }
        """ ;
    ] ;
    sh:sparql [
        sh:name "LabelCellPhysicalShape" ;
        sh:message "A tab:LabelCell with non-empty cellText must carry a tab:onPage (provenance-to-the-page)." ;
        sh:select """
            PREFIX tab: <https://w3id.org/iladub/tab#>
            SELECT $this WHERE {
                $this tab:cellText ?t .
                FILTER(strlen(str(?t)) > 0)
                FILTER NOT EXISTS { $this a tab:EntryCell }
                FILTER NOT EXISTS { $this tab:onPage ?p }
            }
        """ ;
    ] .

# [[R182]] — a label's box must COVER the ink it claims as its provenance.
#
# The membrane half of [[R181]]. build_row_reading joins a wrapped header across N source lines
# and unions their bounds into the leaf label's box; before that fix a joined label shipped under
# a box identical to its last line alone — provenance-to-the-page (CLAUDE.md § 6) present and
# PARTIAL, which is a false claim, not a missing one. Nothing validated it.
#
# CONDITIONAL on the prov:wasDerivedFrom edge, never on its absence: a label no continuation was
# joined into makes no provenance claim, and requiring one would infer from absence (CLAUDE.md § 8
# — the membrane is closed-world about what CROSSES, never about what the ink supported). So the
# constraint is vacuously true for every label of every previously-shipped region, and for the
# record/transposed makers, whose labels come from a single SourceCell with no join at all.
#
# EXACT comparison, no tolerance, deliberately. The label box is the min/max of the very source
# boxes compared against, and both are rounded by the same Decimal(str(round(v, 2))) writer
# (holon.py's _bbox_node), so min/max commutes with the rounding and equality is exact. An EPS
# here would be a tuned constant widening the shape's blind spot (CLAUDE.md § 8), not a safety
# margin — contrast scripts/unbooked_ink_fate.py's EPS, which compares two INDEPENDENTLY rounded
# quantities (a word's extent against a cell's box) and needs one.
#
# The source side is walked through tab:sourceRegion, NOT tab:hasBBox: the latter's rdfs:domain
# would RDFS-type a tab:HeaderSourceCell as a tab:Cell under full closure and trip
# tab:WrappedCellShape (it carries tab:sourceText, not tab:cellText). Measured, not feared — the
# first form of this loop used tab:hasBBox and tests/etkl/test_closure_equiv.py refused 26 nodes
# the membrane admitted. The label side keeps tab:hasBBox, because a tab:LabelCell IS a tab:Cell.
#
# Listed in tiling._PHYSICAL_SHAPE_IRIS as well as here: the gate validates a CBD subset of the
# IRIs those lists name, so a shape in this file alone would let a violating region pass the gate
# and CRASH at compile's final whole-graph validation (the R19 failure, recorded in tiling.py).
tab:LabelCoversProvenanceShape a sh:NodeShape ;
    sh:targetClass tab:LabelCell ;
    sh:sparql [
        sh:name "LabelCoversProvenanceShape" ;
        sh:message "A tab:LabelCell's tab:hasBBox must contain the box of every tab:HeaderSourceCell it prov:wasDerivedFrom (the joined label must cover the ink it was joined from)." ;
        sh:select """
            PREFIX tab:  <https://w3id.org/iladub/tab#>
            PREFIX prov: <http://www.w3.org/ns/prov#>
            SELECT $this WHERE {
                $this prov:wasDerivedFrom ?src .
                ?src a tab:HeaderSourceCell ; tab:sourceRegion ?sb .
                ?sb tab:x0 ?sx0 ; tab:y0 ?sy0 ; tab:x1 ?sx1 ; tab:y1 ?sy1 .
                $this tab:hasBBox ?lb .
                ?lb tab:x0 ?lx0 ; tab:y0 ?ly0 ; tab:x1 ?lx1 ; tab:y1 ?ly1 .
                FILTER (?sx0 < ?lx0 || ?sy0 < ?ly0 || ?sx1 > ?lx1 || ?sy1 > ?ly1)
            }
        """ ;
    ] .
