@prefix etkl: <https://w3id.org/iladub/etkl#> .
@prefix iladub: <https://w3id.org/iladub#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

#################################################################
#  ET(K)L conformance is a CHECKABLE property: "knowledge is not
#  optional, and it comes first" is enforced here, not just asserted.
#################################################################

#  Every contract declares >= 1 target shape and >= 1 knowledge module.
etkl:SemanticDataContractShape a sh:NodeShape ;
    sh:targetClass etkl:SemanticDataContract ;
    sh:property [ sh:path etkl:hasTargetShape ; sh:minCount 1 ;
        sh:message "A contract must declare at least one target shape." ] ;
    sh:property [ sh:path etkl:requiresKnowledge ; sh:minCount 1 ;
        sh:message "A contract must reference at least one knowledge module (knowledge is not optional)." ] .

#  Every transformation has >= 1 knowledge argument and a governing contract.
etkl:TransformationShape a sh:NodeShape ;
    sh:targetClass etkl:Transformation ;
    sh:property [ sh:path etkl:hasKnowledgeArgument ; sh:minCount 1 ;
        sh:message "A transformation must take at least one knowledge module as an argument (knowledge comes first)." ] ;
    sh:property [ sh:path etkl:governedByContract ; sh:minCount 1 ;
        sh:message "A transformation must be governed by a contract." ] .

#  Every extraction applies a contract (knowledge-guided reading).
etkl:ExtractionShape a sh:NodeShape ;
    sh:targetClass etkl:Extraction ;
    sh:property [ sh:path etkl:appliesContract ; sh:minCount 1 ;
        sh:message "An extraction must apply a contract while reading." ] .

#  Every source document declares its format.
etkl:SourceDocumentShape a sh:NodeShape ;
    sh:targetClass etkl:SourceDocument ;
    sh:property [ sh:path etkl:hasFormat ; sh:minCount 1 ;
        sh:message "A source document must declare its format." ] .

#  Every contract field binds a target property.
etkl:FieldShape a sh:NodeShape ;
    sh:targetClass etkl:Field ;
    sh:property [ sh:path etkl:fillsProperty ; sh:minCount 1 ;
        sh:message "A contract field must declare the property it fills." ] .

#  A field carries at most one structural role, and it is one of the three declared ones.
#  Targets the SUBJECTS of etkl:fieldRole, not the class etkl:Field: a field written without
#  its type is still read by `ground.load_contract`, and the membrane's subclass-only closure
#  does not type it from the property's domain.
etkl:FieldRoleShape a sh:NodeShape ;
    sh:targetSubjectsOf etkl:fieldRole ;
    sh:property [ sh:path etkl:fieldRole ; sh:maxCount 1 ;
        sh:message "A contract field carries at most one etkl:fieldRole." ] ;
    sh:property [ sh:path etkl:fieldRole ;
        sh:in ( etkl:RowKey etkl:ColumnKey etkl:CellValue ) ;
        sh:message "A field role is etkl:RowKey, etkl:ColumnKey or etkl:CellValue." ] .

#  A contract that declares ANY role declares the whole matrix reading: exactly one
#  etkl:CellValue field and at most one field per key role. A contract with no role-carrying
#  field is untouched (the first arm of the sh:or). Targets the subjects of etkl:hasField as
#  well as the class, for the reason given on etkl:FieldRoleShape.
#
#  `ground.load_contract` runs this shape and etkl:FieldRoleShape, and refuses the contract
#  they refuse. Run alone because a contract file is a declaration, not a pipeline: the shipped
#  examples/shipping contracts declare no target shape, which etkl:SemanticDataContractShape
#  requires of a conformant ET(K)L pipeline.
etkl:ContractRoleShape a sh:NodeShape ;
    sh:targetClass etkl:SemanticDataContract ;
    sh:targetSubjectsOf etkl:hasField ;
    sh:or (
        [ sh:path ( etkl:hasField etkl:fieldRole ) ; sh:maxCount 0 ]
        [ sh:path etkl:hasField ;
          sh:qualifiedValueShape [ sh:path etkl:fieldRole ; sh:hasValue etkl:CellValue ] ;
          sh:qualifiedMinCount 1 ; sh:qualifiedMaxCount 1 ]
    ) ;
    sh:message "A contract that declares a field role must declare exactly one etkl:CellValue field." ;
    sh:property [ sh:path etkl:hasField ;
        sh:qualifiedValueShape [ sh:path etkl:fieldRole ; sh:hasValue etkl:RowKey ] ;
        sh:qualifiedMaxCount 1 ;
        sh:message "A contract declares at most one etkl:RowKey field." ] ;
    sh:property [ sh:path etkl:hasField ;
        sh:qualifiedValueShape [ sh:path etkl:fieldRole ; sh:hasValue etkl:ColumnKey ] ;
        sh:qualifiedMaxCount 1 ;
        sh:message "A contract declares at most one etkl:ColumnKey field." ] .

#  [[R311]], ruled 2026-10-14: a field that declares a role declares an ORACLE for its value — an
#  etkl:admissibleScheme, or a value constraint on its property's shape. Field identity is not
#  one: the role reaches the field for every key of that role, the empty key included, so it
#  could refuse nothing.
#
#  Reads the contract AND its value shapes, so it validates their UNION and is not one of the
#  shapes `ground.load_contract` runs over the contract alone: the value constraint lives in the
#  shapes file (examples/finance/statement-shapes.ttl), which `ground_document` holds and
#  `load_contract` never receives. `ground.require_role_oracles` runs it there.
#
#  The constraint parameters that count as a value constraint are stated ONCE, on
#  etkl:FieldValueOracle in the etkl ONTOLOGY (vocab/ontology/etkl.ttl), and read from there by
#  this query and by `ground._value_constraints`. The query sees them because pySHACL mixes the
#  ontology graph into the data graph; run without the ontology, no parameter binds and every
#  scheme-less role field is refused: it fails closed.
etkl:RoleFieldOracleShape a sh:NodeShape ;
    sh:targetSubjectsOf etkl:fieldRole ;
    sh:sparql [
        sh:message "A field that declares a role declares an oracle for its value: an etkl:admissibleScheme, or a value constraint on its property's shape." ;
        sh:prefixes etkl:prefixes-role-oracle ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS { $this etkl:admissibleScheme ?scheme }
                FILTER NOT EXISTS {
                    $this etkl:fillsProperty ?p .
                    ?ps sh:path ?p ; ?param ?v .
                    etkl:FieldValueOracle etkl:valueConstraintParameter ?param .
                }
            }
        """ ;
    ] .

etkl:prefixes-role-oracle
    sh:declare [ sh:prefix "etkl" ; sh:namespace "https://w3id.org/iladub/etkl#"^^xsd:anyURI ] ,
               [ sh:prefix "sh" ; sh:namespace "http://www.w3.org/ns/shacl#"^^xsd:anyURI ] .

#################################################################
#  Membrane opacity: a document projection may carry ONLY concepts —
#  never an interior term (candidate concept / promotion decision /
#  source region). The interior stays inside the holon.
#################################################################

etkl:prefixes-fed
    sh:declare [ sh:prefix "iladub" ; sh:namespace "https://w3id.org/iladub#"^^xsd:anyURI ] .

etkl:DocumentProjectionShape a sh:NodeShape ;
    sh:targetClass etkl:DocumentProjection ;
    sh:sparql [
        sh:message "A document projection must carry only concepts — an interior term (CandidateConcept / PromotionDecision / SourceRegion) leaked across the membrane." ;
        sh:prefixes etkl:prefixes-fed ;
        sh:select """
            SELECT $this WHERE {
                { ?x a iladub:CandidateConcept } UNION
                { ?x a iladub:PromotionDecision } UNION
                { ?x a iladub:SourceRegion }
            }
        """ ;
    ] .

#################################################################
#  Membrane health's own shape (holon:05, spec 2026-08-25 §4.8, B7).
#  Deliberately in THIS file: it is the one shape file the compile
#  membrane does not load (src/iladub/etkl/compile.py's _TAB_SHAPE_FILES
#  / _DEC_SHAPE_FILES, src/iladub/feed.py's _GROUND_SHAPE_FILES,
#  src/iladub/etkl/tiling.py's tab-shapes/tab-physical-shapes — none
#  name etkl-shapes.ttl), so the shape inherits that non-loading and
#  spec §2.1's safety argument is untouched. Validated in the test
#  only, never wired in: wiring it would re-open §2.1 and be vacuous,
#  since health does not exist yet when the compile membrane validates.
#  `owl:FunctionalProperty` is rejected, not merely unused: inference
#  is off (membrane.py:124-125) so it would do nothing, and under a
#  reasoner it would entail owl:sameAs between two health values
#  rather than refuse them.
#################################################################

etkl:MembraneHealthShape a sh:NodeShape ;
    sh:targetClass etkl:CompiledDocumentHolon ;
    sh:property [ sh:path etkl:membraneHealth ; sh:maxCount 1 ;
                  sh:in ( etkl:Intact etkl:Weakened etkl:Compromised ) ] .

#################################################################
#  The carried ignored band (R212). In THIS file, so it inherits the
#  non-loading MembraneHealthShape above deliberately has: the compile
#  membrane runs no shape at all on a page with no table (see
#  compile.compile_tables' validate_shapes guard), and a page of pure
#  furniture is precisely the page with the most ignored bands — so
#  wiring this shape in would buy enforcement that LOOKS total and is
#  silently absent exactly where the carrier matters most. Enforcement
#  is instead the vocabulary convention (tests/test_vocab_shapes.py)
#  plus a test validating a REAL compiled page graph against this file
#  (tests/etkl/test_ignored_band_carrier.py).
#
#  Text and page are REQUIRED, and that is the point: tab:RegionCaption
#  is the carried node that decayed into a typed-but-empty stub with no
#  page and no provenance ([[R218]]), and this shape is what forbids the
#  carrier repeating it.
#################################################################

etkl:IgnoredBandShape a sh:NodeShape ;
    sh:targetClass etkl:IgnoredBand ;
    sh:property [ sh:path etkl:bandText ; sh:minCount 1 ; sh:datatype xsd:string ;
        sh:message "An ignored band must carry the band's exact surface text — that text is the whole reason the node exists." ] ;
    sh:property [ sh:path etkl:bandIndex ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ;
        sh:message "An ignored band must carry exactly one band index, typed xsd:integer." ] ;
    sh:property [ sh:path etkl:ignoredBecause ; sh:minCount 1 ;
        sh:message "An ignored band must carry the reader's own reason for the NON_TABLE verdict." ] ;
    sh:property [ sh:path iladub:fromRegion ; sh:minCount 1 ;
        sh:message "An ignored band must record its source region (provenance)." ] ;
    #  The page is required ON THE REGION, never on the band node: iladub:onPage
    #  carries rdfs:domain iladub:SourceRegion and its comment records at length why
    #  it may sit nowhere else (the R69 mechanism). Stated as a SEQUENCE PATH from the
    #  band rather than as a second NodeShape targeting iladub:SourceRegion, because
    #  such a shape would fire on every escalated region in every compiled graph.
    sh:property [ sh:path ( iladub:fromRegion iladub:onPage ) ; sh:minCount 1 ;
        sh:message "An ignored band must reach a page through its source region (provenance to the page)." ] .
