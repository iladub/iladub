@prefix etkl: <https://w3id.org/iladub/etkl#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

#################################################################
#  ET(K)L conformance is a CHECKABLE property: "knowledge is not
#  optional, and it comes first" is enforced here, not just asserted.
#################################################################

#  Every contract declares >= 1 target shape and >= 1 knowledge module.
etkl:SemanticDataContractShape a sh:NodeShape ;
    sh:targetClass etkl:SemanticDataContract ;
    sh:property [ sh:path etkl:hasTargetShape ; sh:minCount 1 ;
        sh:message "A contract must declare at least one target shape." ] ;
    sh:property [ sh:path etkl:requiresKnowledge ; sh:minCount 1 ;
        sh:message "A contract must reference at least one knowledge module (knowledge is not optional)." ] .

#  Every transformation has >= 1 knowledge argument and a governing contract.
etkl:TransformationShape a sh:NodeShape ;
    sh:targetClass etkl:Transformation ;
    sh:property [ sh:path etkl:hasKnowledgeArgument ; sh:minCount 1 ;
        sh:message "A transformation must take at least one knowledge module as an argument (knowledge comes first)." ] ;
    sh:property [ sh:path etkl:governedByContract ; sh:minCount 1 ;
        sh:message "A transformation must be governed by a contract." ] .

#  Every extraction applies a contract (knowledge-guided reading).
etkl:ExtractionShape a sh:NodeShape ;
    sh:targetClass etkl:Extraction ;
    sh:property [ sh:path etkl:appliesContract ; sh:minCount 1 ;
        sh:message "An extraction must apply a contract while reading." ] .

#  Every source document declares its format.
etkl:SourceDocumentShape a sh:NodeShape ;
    sh:targetClass etkl:SourceDocument ;
    sh:property [ sh:path etkl:hasFormat ; sh:minCount 1 ;
        sh:message "A source document must declare its format." ] .

#  Every contract field binds a target property.
etkl:FieldShape a sh:NodeShape ;
    sh:targetClass etkl:Field ;
    sh:property [ sh:path etkl:fillsProperty ; sh:minCount 1 ;
        sh:message "A contract field must declare the property it fills." ] .

#################################################################
#  Membrane opacity: a document projection may carry ONLY concepts —
#  never an interior term (candidate concept / promotion decision /
#  source region). The interior stays inside the holon.
#################################################################

etkl:prefixes-fed
    sh:declare [ sh:prefix "iladub" ; sh:namespace "https://w3id.org/iladub#"^^xsd:anyURI ] .

etkl:DocumentProjectionShape a sh:NodeShape ;
    sh:targetClass etkl:DocumentProjection ;
    sh:sparql [
        sh:message "A document projection must carry only concepts — an interior term (CandidateConcept / PromotionDecision / SourceRegion) leaked across the membrane." ;
        sh:prefixes etkl:prefixes-fed ;
        sh:select """
            SELECT $this WHERE {
                { ?x a iladub:CandidateConcept } UNION
                { ?x a iladub:PromotionDecision } UNION
                { ?x a iladub:SourceRegion }
            }
        """ ;
    ] .

#################################################################
#  Membrane health's own shape (holon:05, spec 2026-08-25 §4.8, B7).
#  Deliberately in THIS file: it is the one shape file the compile
#  membrane does not load (src/iladub/etkl/compile.py's _TAB_SHAPE_FILES
#  / _DEC_SHAPE_FILES, src/iladub/feed.py's _GROUND_SHAPE_FILES,
#  src/iladub/etkl/tiling.py's tab-shapes/tab-physical-shapes — none
#  name etkl-shapes.ttl), so the shape inherits that non-loading and
#  spec §2.1's safety argument is untouched. Validated in the test
#  only, never wired in: wiring it would re-open §2.1 and be vacuous,
#  since health does not exist yet when the compile membrane validates.
#  `owl:FunctionalProperty` is rejected, not merely unused: inference
#  is off (membrane.py:124-125) so it would do nothing, and under a
#  reasoner it would entail owl:sameAs between two health values
#  rather than refuse them.
#################################################################

etkl:MembraneHealthShape a sh:NodeShape ;
    sh:targetClass etkl:CompiledDocumentHolon ;
    sh:property [ sh:path etkl:membraneHealth ; sh:maxCount 1 ;
                  sh:in ( etkl:Intact etkl:Weakened etkl:Compromised ) ] .
