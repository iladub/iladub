@prefix iladub: <https://w3id.org/iladub#> .
@prefix etkl:   <https://w3id.org/iladub/etkl#> .
@prefix dec:    <https://w3id.org/iladub/dec#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms:<http://purl.org/dc/terms/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix vann:   <http://purl.org/vocab/vann/> .

#################################################################
#  Ontology metadata
#  etkl's holon-production fabric (moved from the iladub core 2026-07-01). STANDALONE and reasoner-free:
#  this file has NO dependency on the W3C Holon CG ontology. The
#  alignment to HGA (`holon:`) lives in the optional, separately
#  loadable module `iladub-hga-align.ttl` (alignment-not-import).
#  See docs/holonic-interaction.md and CLAUDE.md ("Holonic interaction
#  model").
#################################################################

<https://w3id.org/iladub/etkl/holons> a owl:Ontology ;
    dcterms:title "etkl — holon-production fabric"@en ;
    dcterms:description """The holons iladub compiles with, and the portal through which
they interact. A RawDocumentHolon and the SemanticHolons (provided ontologies / SKOS
terminology) interact through a governed GroundingPortal, producing a CleanDocumentHolon
whose interior is the grounded graph and whose cleanliness IS its membrane health.
Defined in the etkl namespace and standalone; the optional HGA alignment module anchors
these under the W3C Holon CG ontology by rdfs:subClassOf."""@en ;
    dcterms:creator "François Rosselet" ;
    dcterms:created "2026-06-23"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    owl:versionInfo "0.2.0" ;
    vann:preferredNamespacePrefix "etkl" ;
    vann:preferredNamespaceUri "https://w3id.org/iladub/etkl#" ;
    rdfs:seeAlso <https://w3id.org/iladub/etkl> ,
                 <https://w3id.org/iladub/hga-alignment> .

#################################################################
#  Holon types
#################################################################

etkl:DocumentHolon a owl:Class ;
    rdfs:label "Document Holon"@en ;
    rdfs:comment "A document as a holon: an information-bearing artefact with an interior, a membrane, a projection and a context. Abstract parent of the raw and clean document holons."@en .

etkl:RawDocumentHolon a owl:Class ;
    rdfs:subClassOf etkl:DocumentHolon ;
    rdfs:label "Raw Document Holon"@en ;
    rdfs:comment "The source document as a holon. Interior: the Document Region Graph (prose, tables, figures, reading order). Projection: the surface concepts / mentions it offers for grounding. Context: acquisition provenance."@en .

etkl:SemanticHolon a owl:Class ;
    rdfs:subClassOf etkl:DocumentHolon ;
    rdfs:label "Semantic Holon"@en ;
    rdfs:comment "A knowledge module — a provided ontology or SKOS terminology — as a holon. Interior: the vocabulary. Projection: the concepts available for grounding. It is the grounding source the portal reconciles against."@en .

etkl:AlignmentHolon a owl:Class ;
    rdfs:subClassOf etkl:SemanticHolon ;
    rdfs:label "Alignment Holon"@en ;
    rdfs:comment "A SemanticHolon whose purpose is to bridge vocabularies (e.g. SNOMED ↔ a domain concept)."@en .

etkl:CleanDocumentHolon a owl:Class ;
    rdfs:subClassOf etkl:DocumentHolon ;
    rdfs:label "Clean Document Holon"@en ;
    rdfs:comment "The compiled output as a holon. Interior: the grounded graph + the promotion decisions that produced it. Membrane: the contract's SHACL shapes. Projection: the FAIR graph machines consume. Context: provenance-to-region + the decision log. Its cleanliness is its membrane health."@en .

etkl:GroundingPortal a owl:Class ;
    rdfs:label "Grounding Portal"@en ;
    rdfs:comment "The governed, liminal interaction through which a RawDocumentHolon and the SemanticHolons reconcile concepts — itself a holon. Unlike a bare navigational link, the grounding portal carries the concept-matching TRANSFORM, and convergence (table cell / prose / figure resolving to the SAME concept IRI) is region-holons reconciled through it. Crossing the portal is governed by iladub:PromotionDecision."@en .

#################################################################
#  Membrane health — "clean" is not a vibe, it is membrane health
#################################################################

etkl:MembraneHealth a owl:Class ;
    rdfs:label "Membrane Health"@en ;
    rdfs:comment "The health of a holon's boundary, derived from two kinds of evidence that are both PRESENT in the graph: whether the interior conformed when the membrane last validated it, and whether any proposition is still HELD at that boundary. It is NOT the compilation score — a document may be read incompletely and still be Intact, because nothing is held."@en .

etkl:Intact      a etkl:MembraneHealth ; rdfs:label "intact"@en ;
    rdfs:comment "Interior fully conforms to the membrane."@en .
etkl:Weakened    a etkl:MembraneHealth ; rdfs:label "weakened"@en ;
    rdfs:comment "Interior conforms, but at least one proposition is HELD at the membrane: a candidate concept that no promotion decision has admitted. This is not a severity — no SHACL warning exists in this contract — and it says nothing about how much of the document was read."@en .
etkl:Compromised a etkl:MembraneHealth ; rdfs:label "compromised"@en ;
    rdfs:comment "Interior violates the membrane: the holon is not clean."@en .

etkl:membraneHealth a owl:ObjectProperty ;
    rdfs:label "membrane health"@en ;
    rdfs:domain etkl:DocumentHolon ; rdfs:range etkl:MembraneHealth ;
    rdfs:comment "The membrane-health signal computed for this holon."@en .

#################################################################
#  The compile-scope product, and the act that validates it
#  (holon:05, spec 2026-08-25 §4.1/§4.2; B1 and B2 rulings)
#################################################################

etkl:CompiledDocumentHolon a owl:Class ;
    rdfs:subClassOf etkl:DocumentHolon ;
    rdfs:label "Compiled Document Holon"@en ;
    rdfs:comment "The product of compiling a document, as a holon: the merged document-scope graph a compile emits — the regions read from each page, the continuation chains recognized across the page breaks, and the decision record that produced them. Deliberately NOT an etkl:CleanDocumentHolon, whose interior is the grounded graph and the promotion decisions that produced it: a compile graph contains neither, and the two are disjoint artefacts. Its membrane health reports what is HELD at the boundary, never how much of the document was read — that is the compilation score, a different signal."@en .

etkl:MembraneValidation a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Membrane Validation"@en ;
    rdfs:comment "One act of validating a holon's interior against its membrane. It records that a validation HAPPENED and what it returned — not the graph's conformance status as a property of the graph. prov:used names the holon validated, sh:conforms carries the engine's verdict as an xsd:boolean, and etkl:refusingLeg names each shape set that refused. It is the evidence membrane health is derived FROM, which is why health is a derivation and not a stored label."@en .

etkl:refusingLeg a owl:DatatypeProperty ;
    rdfs:label "refusing leg"@en ;
    rdfs:domain etkl:MembraneValidation ; rdfs:range xsd:string ;
    rdfs:comment "A shape set that REFUSED in this validation, named by the code-level key the membrane uses for it (\"tab\", \"dec\"). Zero-to-many: a leg appears only when it has something to say, so a validation that conformed names none."@en .

#################################################################
#  Interaction properties
#################################################################

etkl:throughPortal a owl:ObjectProperty ;
    rdfs:label "through portal"@en ;
    rdfs:domain etkl:CleanDocumentHolon ; rdfs:range etkl:GroundingPortal ;
    rdfs:comment "The grounding portal through which this clean document holon was compiled."@en .

etkl:reconciles a owl:ObjectProperty ;
    rdfs:label "reconciles"@en ;
    rdfs:domain etkl:GroundingPortal ; rdfs:range iladub:SourceRegion ;
    rdfs:comment "A source region the portal reconciled onto a shared concept IRI (the convergence principle)."@en .
