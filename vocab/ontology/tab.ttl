@prefix tab:     <https://w3id.org/iladub/tab#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .

#################################################################
#  Ontology metadata
#################################################################

<https://w3id.org/iladub/tab> a owl:Ontology ;
    dcterms:title "tab — tabular-topology vocabulary"@en ;
    dcterms:description "Domain-neutral topology of tables as intentional transformation stacks (flat -> pivot -> cosmetic). Standalone core; alignment to csvw:/qb:/prov:/holon: lives in tab-*-align.ttl."@en ;
    dcterms:creator "François Rosselet" ;
    dcterms:created "2026-07-05"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    owl:versionInfo "0.2.0" ;
    vann:preferredNamespacePrefix "tab" ;
    vann:preferredNamespaceUri "https://w3id.org/iladub/tab#" .

# --- the table (a holon) and its kinds -----------------------------------------
tab:Table a owl:Class ; rdfs:label "Table"@en ;
    rdfs:comment "A table-holon: entries indexed by header paths; not an array."@en .
tab:HierarchicalTable a owl:Class ; rdfs:subClassOf tab:Table ;
    rdfs:label "Hierarchical table"@en ;
    rdfs:comment "A table with a multi-level header tree on a column or row axis."@en .

# --- cells and their roles (Wang: label vs entry) ------------------------------
tab:Cell a owl:Class ; rdfs:label "Cell"@en ;
    rdfs:comment "Abstract supertype; a cell is either a LabelCell or an EntryCell."@en .
tab:LabelCell a owl:Class ; rdfs:subClassOf tab:Cell ; rdfs:label "Label cell"@en ;
    rdfs:comment "A cell that locates entries (a header or stub label)."@en .
tab:EntryCell a owl:Class ; rdfs:subClassOf tab:Cell ; rdfs:label "Entry cell"@en ;
    rdfs:comment "A cell that carries a fact, addressed by a column path x row path."@en .

# --- header trees and leaves ---------------------------------------------------
tab:HeaderNode a owl:Class ; rdfs:label "Header node"@en ;
    rdfs:comment "A node in a header tree; covers a contiguous run of leaf columns."@en .
tab:LeafColumn a owl:Class ; rdfs:label "Leaf column"@en ;
    rdfs:comment "A terminal column addressed by a column-header path."@en .
tab:LeafRow a owl:Class ; rdfs:label "Leaf row"@en ;
    rdfs:comment "A terminal row addressed by a row-header path."@en .

tab:parentHeader a owl:ObjectProperty ; rdfs:label "parent header"@en ;
    rdfs:domain tab:HeaderNode ; rdfs:range tab:HeaderNode ;
    rdfs:comment "Links a header node to its parent (child span must be a subset of the parent's)."@en .
tab:coversColumn a owl:ObjectProperty ; rdfs:label "covers column"@en ;
    rdfs:domain tab:HeaderNode ; rdfs:range tab:LeafColumn ;
    rdfs:comment "A leaf column in this header node's span."@en .
tab:coversRow a owl:ObjectProperty ; rdfs:label "covers row"@en ;
    rdfs:domain tab:HeaderNode ; rdfs:range tab:LeafRow ;
    rdfs:comment "A leaf row in this header node's (vertical) span — the row-axis mirror of tab:coversColumn."@en .
tab:hasLabel a owl:ObjectProperty ; rdfs:label "has label"@en ;
    rdfs:domain tab:HeaderNode ; rdfs:range tab:LabelCell ;
    rdfs:comment "Links a header node to the LabelCell carrying its surface text + geometry."@en .
tab:headerLevel a owl:DatatypeProperty ; rdfs:label "header level"@en ;
    rdfs:domain tab:HeaderNode ; rdfs:range xsd:integer ;
    rdfs:comment "Depth of this node (0 = topmost)."@en .

# --- table composition ---------------------------------------------------------
tab:hasHeaderNode a owl:ObjectProperty ;
    rdfs:label "has header node"@en ;
    rdfs:comment "A header node of this table."@en ;
    rdfs:domain tab:Table ; rdfs:range tab:HeaderNode .
tab:hasLeafColumn a owl:ObjectProperty ;
    rdfs:label "has leaf column"@en ;
    rdfs:comment "A leaf column of this table."@en ;
    rdfs:domain tab:Table ; rdfs:range tab:LeafColumn .
tab:hasLeafRow a owl:ObjectProperty ;
    rdfs:label "has leaf row"@en ;
    rdfs:comment "A leaf row of this table."@en ;
    rdfs:domain tab:Table ; rdfs:range tab:LeafRow .
tab:hasCell a owl:ObjectProperty ;
    rdfs:label "has cell"@en ;
    rdfs:comment "A cell belonging to this table."@en ;
    rdfs:domain tab:Table ; rdfs:range tab:Cell .

# --- the access function (Wang's map: entry <- column path x row path) ---------
tab:atColumn a owl:ObjectProperty ; rdfs:label "at column"@en ;
    rdfs:domain tab:EntryCell ; rdfs:range tab:LeafColumn .
tab:atRow a owl:ObjectProperty ; rdfs:label "at row"@en ;
    rdfs:domain tab:EntryCell ; rdfs:range tab:LeafRow .

# --- kinds (v1) ----------------------------------------------------------------
tab:RecordTable a owl:Class ; rdfs:subClassOf tab:Table ;
    rdfs:label "Record table"@en ;
    rdfs:comment "A flat table: a single-level header with one label per leaf column, and rows of entries."@en .
tab:TransposedTable a owl:Class ; rdfs:subClassOf tab:Table ;
    rdfs:label "Transposed table"@en ;
    rdfs:comment "A table whose records run along columns and whose fields run down the first column (rows are attributes). Compiled by axis-flip into a tab:RecordTable with tab:sourceOrientation \"transposed\"; also the escalation anchor when a detected transposition is not confidently compilable."@en .

tab:sourceOrientation a owl:DatatypeProperty ;
    rdfs:domain tab:Table ; rdfs:range xsd:string ;
    rdfs:label "source orientation"@en ;
    rdfs:comment "The physical orientation of the source region a table-holon was recovered from: \"transposed\" when records ran along physical columns and the holon was recovered by axis-flip. Absent means upright. The holon's logical kind is unaffected."@en .

# --- physical layer (geometry + surface text; needed for round-trip + provenance) ---
tab:cellText a owl:DatatypeProperty ; rdfs:label "cell text"@en ;
    rdfs:domain tab:Cell ; rdfs:range rdfs:Literal ;
    rdfs:comment "The surface text a cell carries. Language-tagged literals are allowed; NOT constrained to xsd:string."@en .
tab:onPage a owl:DatatypeProperty ; rdfs:label "on page"@en ;
    rdfs:domain tab:Cell ; rdfs:range xsd:integer ;
    rdfs:comment "Zero-based index of the page the cell was measured on."@en .
tab:hasBBox a owl:ObjectProperty ; rdfs:label "has bbox"@en ;
    rdfs:domain tab:Cell ; rdfs:range tab:BBox ;
    rdfs:comment "The measured bounding box of the cell, in PDF points."@en .
tab:BBox a owl:Class ; rdfs:label "Bounding box"@en ;
    rdfs:comment "A rectangle in PDF points: x0/x1 from the page left, y0/y1 (top/bottom) from the page top."@en .
tab:x0 a owl:DatatypeProperty ; rdfs:domain tab:BBox ; rdfs:range xsd:decimal ; rdfs:label "x0"@en .
tab:y0 a owl:DatatypeProperty ; rdfs:domain tab:BBox ; rdfs:range xsd:decimal ; rdfs:label "y0"@en .
tab:x1 a owl:DatatypeProperty ; rdfs:domain tab:BBox ; rdfs:range xsd:decimal ; rdfs:label "x1"@en .
tab:y1 a owl:DatatypeProperty ; rdfs:domain tab:BBox ; rdfs:range xsd:decimal ; rdfs:label "y1"@en .

# --- pivoted dimensions (denormalisation evidence) ---------------------------
tab:PivotedDimension a owl:Class ; rdfs:label "Pivoted dimension"@en ;
    rdfs:comment "A dimension recovered from a header axis: a normalized column/attribute a report pivoted into the header hierarchy."@en .
tab:dimensionName a owl:DatatypeProperty ; rdfs:domain tab:PivotedDimension ; rdfs:range xsd:string ; rdfs:label "dimension name"@en .
tab:onAxis a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "on axis"@en ;
    rdfs:comment "row | column."@en .
tab:atLevel a owl:DatatypeProperty ; rdfs:domain tab:PivotedDimension ; rdfs:range xsd:integer ; rdfs:label "at level"@en .
tab:hasDimensionValue a owl:DatatypeProperty ; rdfs:domain tab:PivotedDimension ; rdfs:range xsd:string ; rdfs:label "has dimension value"@en .

# --- aggregation evidence (denormalisation slice ②) --------------------------
tab:AggregationCell a owl:Class ; rdfs:subClassOf tab:EntryCell ; rdfs:label "Aggregation cell"@en ;
    rdfs:comment "A derived (computed) entry cell — an aggregate of a group of base cells."@en .
tab:AggregationRow a owl:Class ; rdfs:subClassOf tab:LeafRow ; rdfs:label "Aggregation row"@en .
tab:AggregationColumn a owl:Class ; rdfs:subClassOf tab:LeafColumn ; rdfs:label "Aggregation column"@en .
tab:aggregationFunction a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "aggregation function"@en ;
    rdfs:comment "sum | mean | count | min | max | product."@en .
tab:aggregates a owl:ObjectProperty ; rdfs:label "aggregates"@en ;
    rdfs:comment "An operand this aggregation is computed from: an EntryCell when the subject is an AggregationCell (denormalization's cell-level operands), or a LeafRow when the subject is a DetectedAggregationRow (loop H's row-level operands). Domain/range deliberately left undeclared: either would rdfs-entail the OTHER usage's subject/object into a foreign class (e.g. a LeafRow inferred AggregationCell), tripping that class's shape at full validation — see tests/etkl/test_aggregation_rows.py's landmine test."@en .
tab:overAxis a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "over axis"@en ;
    rdfs:comment "row | column — the axis the aggregation runs along (a grand total carries both)."@en .

# --- 3NF base facts (denormalisation slice ③) --------------------------------
tab:BaseFact a owl:Class ; rdfs:label "Base fact"@en ;
    rdfs:comment "A normalized (3NF) observation recovered by inverting a report: a dimension-value coordinate and a measure."@en .
tab:measureValue a owl:DatatypeProperty ; rdfs:domain tab:BaseFact ; rdfs:range xsd:decimal ; rdfs:label "measure value"@en .
tab:atDimensionValue a owl:ObjectProperty ; rdfs:domain tab:BaseFact ; rdfs:label "at dimension value"@en ;
    rdfs:comment "A coordinate node: a tab:dimensionName + tab:value the base fact carries."@en .
tab:value a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "value"@en .

# --- reshape recipe (inverse report-authoring grammar; Loop A1) ----------------
tab:ReshapeRecipe a owl:Class ; rdfs:label "Reshape recipe"@en ;
    rdfs:comment "An ordered sequence of inverse report-authoring operations that regenerate a report from its flat base. Certified by round-trip reproduction."@en .
tab:ReshapeOperation a owl:Class ; rdfs:label "Reshape operation"@en ;
    rdfs:comment "One operation in a reshape recipe (unpivot, strip-aggregation, ...)."@en .
tab:UnpivotOp a owl:Class ; rdfs:subClassOf tab:ReshapeOperation ; rdfs:label "Unpivot operation"@en ;
    rdfs:comment "Inverse of pivot: a named dimension whose values were rotated into a header axis is folded back into one column."@en .
tab:StripAggregationOp a owl:Class ; rdfs:subClassOf tab:ReshapeOperation ; rdfs:label "Strip-aggregation operation"@en ;
    rdfs:comment "Inverse of add-subtotal/total: a derived row/column proven by exact arithmetic is removed (re-derivable)."@en .
tab:hasOperation a owl:ObjectProperty ; rdfs:domain tab:ReshapeRecipe ; rdfs:range tab:ReshapeOperation ; rdfs:label "has operation"@en .
tab:recipeForTable a owl:ObjectProperty ; rdfs:domain tab:ReshapeRecipe ; rdfs:label "recipe for table"@en .
tab:opIndex a owl:DatatypeProperty ; rdfs:domain tab:ReshapeOperation ; rdfs:range xsd:integer ; rdfs:label "operation index"@en ;
    rdfs:comment "Position in the recipe; forward replay applies operations in ascending order."@en .
tab:opDimension a owl:DatatypeProperty ; rdfs:domain tab:UnpivotOp ; rdfs:range xsd:string ; rdfs:label "operation dimension"@en .
tab:opStub a owl:DatatypeProperty ; rdfs:domain tab:UnpivotOp ; rdfs:range xsd:string ; rdfs:label "operation stub"@en .
tab:opAxis a owl:DatatypeProperty ; rdfs:domain tab:ReshapeOperation ; rdfs:range xsd:string ; rdfs:label "operation axis"@en ;
    rdfs:comment "row | column."@en .
tab:opFunction a owl:DatatypeProperty ; rdfs:domain tab:StripAggregationOp ; rdfs:range xsd:string ; rdfs:label "operation function"@en ;
    rdfs:comment "sum | mean | count | min | max | product — FnO/F&O-named in tab-fno-align.ttl."@en .
tab:opTargetLabel a owl:DatatypeProperty ; rdfs:domain tab:StripAggregationOp ; rdfs:range xsd:string ;
    rdfs:label "operation target label"@en ;
    rdfs:comment "The leaf label of the aggregate row/column this strip op removes and re-derives (e.g. \"Total\")."@en .
tab:opMember a owl:DatatypeProperty ; rdfs:domain tab:StripAggregationOp ; rdfs:range xsd:string ;
    rdfs:label "operation member"@en ;
    rdfs:comment "A base member label the aggregate is computed from (repeated once per member)."@en .
tab:opValue a owl:DatatypeProperty ; rdfs:domain tab:UnpivotOp ; rdfs:range xsd:string ;
    rdfs:label "operation value"@en ;
    rdfs:comment "A pivot value naming a measure column for a NAMELESS column pivot, where measure columns are detected by value-set membership rather than a level-0 dimension-name header (A2.1). Repeated once per value."@en .

# --- reconstruction cells (round-trip oracle only; never merged into the source table) ---
tab:ReproCell a owl:Class ; rdfs:label "Reconstruction cell"@en ;
    rdfs:comment "A grid cell regenerated by the forward reshape CONSTRUCTs for round-trip verification; transient, never asserted into a table holon."@en .
tab:reproRow a owl:DatatypeProperty ; rdfs:domain tab:ReproCell ; rdfs:range xsd:string ; rdfs:label "repro row"@en .
tab:reproCol a owl:DatatypeProperty ; rdfs:domain tab:ReproCell ; rdfs:range xsd:string ; rdfs:label "repro column"@en .
tab:reproText a owl:DatatypeProperty ; rdfs:domain tab:ReproCell ; rdfs:range rdfs:Literal ; rdfs:label "repro text"@en .

# --- normalized base (derived projection; re-models the stored BaseFact set) ----
tab:NormalizedBase a owl:Class ; rdfs:label "Normalized base"@en ;
    rdfs:comment "The flat (3NF) facts a report was built from — a DERIVED projection produced by an oracle-certified recipe, never stored as ground truth."@en .
tab:derivedByRecipe a owl:ObjectProperty ; rdfs:domain tab:NormalizedBase ; rdfs:range tab:ReshapeRecipe ; rdfs:label "derived by recipe"@en .
tab:hasBaseFact a owl:ObjectProperty ; rdfs:domain tab:NormalizedBase ; rdfs:range tab:BaseFact ; rdfs:label "has base fact"@en .

# --- A2 promotion link (rangeless: points at a promotion decision at runtime) -----
tab:namePromotedBy a owl:ObjectProperty ; rdfs:label "name promoted by"@en ;
    rdfs:comment "Links a reshape operation whose dimension name was GenAI-proposed to the promotion decision that admitted the name. Rangeless to keep this ontology standalone."@en .

# --- transient inference marks (recovery pass; not stored in a holon) ---
tab:namesLevel a owl:DatatypeProperty ; rdfs:domain tab:HeaderNode ; rdfs:range xsd:integer ;
    rdfs:label "names level"@en ;
    rdfs:comment "A recovery mark: this header node (a unique spanning parent) NAMES the pivoted dimension one header level below it. Produced by the name-levels derivation; transient, not asserted into a holon."@en .

tab:barredAsOperand a owl:DatatypeProperty ; rdfs:domain tab:LeafColumn ; rdfs:range xsd:boolean ;
    rdfs:label "barred as operand"@en ;
    rdfs:comment "A recovery mark: in a pivoted table this level-0 single-leaf column is a stub/total, barred as an aggregation operand. Transient; produced by the operand-exclusions derivation."@en .

# --- typed-cell evidence graph (transient, pre-holon; loop B2a) ---
tab:GridCell a owl:Class ; rdfs:label "Grid cell"@en ;
    rdfs:comment "A transient (line, column) cell of a candidate region, with its surface text and recovered datatype. Evidence for the type/orientation derivations; never asserted into a holon."@en .
tab:atGridRow a owl:DatatypeProperty ; rdfs:domain tab:GridCell ; rdfs:range xsd:integer ; rdfs:label "at grid row"@en .
tab:atGridColumn a owl:DatatypeProperty ; rdfs:domain tab:GridCell ; rdfs:range xsd:integer ; rdfs:label "at grid column"@en .
tab:gridText a owl:DatatypeProperty ; rdfs:domain tab:GridCell ; rdfs:range rdfs:Literal ; rdfs:label "grid text"@en .
tab:CellDatatype a owl:Class ; rdfs:label "Cell datatype"@en ;
    rdfs:comment "An OPEN lattice of recovered cell datatypes. Loop A: tab:Blank | tab:Numeric | tab:Text. Loop B2b extends it with tab:Date and tab:Currency; Boolean/Code are planned for a later loop."@en .
tab:Blank    a tab:CellDatatype ; rdfs:label "Blank"@en ;
    rdfs:comment "A genuinely-missing cell: empty, the self-declaring '(blank)', or a lone '-'. Not a datum — excluded from a column's dominant type and treated as a wildcard by the header/body split derivation."@en .
tab:Numeric  a tab:CellDatatype ; rdfs:label "Numeric"@en .
tab:Text     a tab:CellDatatype ; rdfs:label "Text"@en .
tab:Date     a tab:CellDatatype ; rdfs:label "Date"@en .
tab:Currency a tab:CellDatatype ; rdfs:label "Currency"@en .
tab:cellDatatype a owl:ObjectProperty ; rdfs:domain tab:GridCell ; rdfs:range tab:CellDatatype ; rdfs:label "cell datatype"@en .
tab:columnIndex a owl:DatatypeProperty ; rdfs:range xsd:integer ; rdfs:label "column index"@en ;
    rdfs:comment "A grid column marker (0..ncols-1) so empty columns are visible to the stub/data derivation."@en .

# --- band-classification evidence graph (transient, pre-holon; loop B2c) ---
tab:ClassifyBand a owl:Class ; rdfs:label "Classify band"@en ;
    rdfs:comment "A transient candidate band being classified into a region kind. Evidence for the kind derivation (regions.classify); never asserted into a holon."@en .
tab:lineCount a owl:DatatypeProperty ; rdfs:domain tab:ClassifyBand ; rdfs:range xsd:integer ; rdfs:label "line count"@en .
tab:gridColumnCount a owl:DatatypeProperty ; rdfs:domain tab:ClassifyBand ; rdfs:range xsd:integer ; rdfs:label "grid column count"@en ;
    rdfs:comment "grid.ncols from infer_leaf_grid; 0 when the band has fewer than 2 lines (grid undefined)."@en .
tab:HeaderWord a owl:Class ; rdfs:label "Header word"@en ;
    rdfs:comment "A word on the band's header line (line 0), for the 1:1 clean-tiling test."@en .
tab:headerWordOrder a owl:DatatypeProperty ; rdfs:domain tab:HeaderWord ; rdfs:range xsd:integer ; rdfs:label "header word order"@en ;
    rdfs:comment "The word's 0-based left-to-right position among the header words (sorted by x0)."@en .
tab:strictlyInColumn a owl:DatatypeProperty ; rdfs:domain tab:HeaderWord ; rdfs:range xsd:integer ; rdfs:label "strictly in column"@en ;
    rdfs:comment "The unique column index the word is strictly inside (per _word_in_column); OMITTED when the word straddles a gutter."@en .
tab:RegionKind a owl:Class ; rdfs:label "Region kind"@en ;
    rdfs:comment "The classification verdict for a band. Its individuals are verdicts, NOT the compiled-holon table classes (tab:RecordTable a owl:Class subClassOf tab:Table) — hence the distinct '…Kind' IRIs to avoid dual-typing an existing class."@en .
tab:RecordTableKind a tab:RegionKind ; rdfs:label "Record table (kind)"@en .
tab:UnsupportedTableKind a tab:RegionKind ; rdfs:label "Unsupported table (kind)"@en .
tab:NonTableKind a tab:RegionKind ; rdfs:label "Non table (kind)"@en .

# --- header-covering evidence graph (transient, pre-holon; loop B) ---
tab:HeaderCell a owl:Class ; rdfs:label "Header cell"@en ;
    rdfs:comment "A transient header-region cell (row, text, ink x-extent), evidence for the leaf-row column-covering derivation (header-covers.rq); never asserted into a holon."@en .
tab:GridColumn a owl:Class ; rdfs:label "Grid column"@en ;
    rdfs:comment "A transient leaf column (index + center-x), evidence for the covering derivation; never asserted into a holon."@en .
tab:atHeaderRow a owl:DatatypeProperty ; rdfs:domain tab:HeaderCell ; rdfs:range xsd:integer ; rdfs:label "at header row"@en ;
    rdfs:comment "0-based header-region row index (0 = topmost). The leaf row is MAX(atHeaderRow)."@en .
tab:headerText a owl:DatatypeProperty ; rdfs:domain tab:HeaderCell ; rdfs:range rdfs:Literal ; rdfs:label "header text"@en .
tab:cellIndex a owl:DatatypeProperty ; rdfs:domain tab:HeaderCell ; rdfs:range xsd:integer ; rdfs:label "cell index"@en ;
    rdfs:comment "0-based left-to-right position of the cell within its header row."@en .
tab:inkX0 a owl:DatatypeProperty ; rdfs:domain tab:HeaderCell ; rdfs:range xsd:double ; rdfs:label "ink x0"@en .
tab:inkX1 a owl:DatatypeProperty ; rdfs:domain tab:HeaderCell ; rdfs:range xsd:double ; rdfs:label "ink x1"@en .
tab:inkCenterX a owl:DatatypeProperty ; rdfs:domain tab:HeaderCell ; rdfs:range xsd:double ; rdfs:label "ink center x"@en ;
    rdfs:comment "The label's ink x-midpoint (inkX0+inkX1)/2, raw geometry. The column whose [colX0,colX1) contains it is the leaf label's column (header-covers.rq)."@en .
tab:colIndex a owl:DatatypeProperty ; rdfs:domain tab:GridColumn ; rdfs:range xsd:integer ; rdfs:label "col index"@en .
tab:colCenterX a owl:DatatypeProperty ; rdfs:domain tab:GridColumn ; rdfs:range xsd:double ; rdfs:label "col center x"@en ;
    rdfs:comment "The x-midpoint of the column: (boundaries[i] + boundaries[i+1]) / 2."@en .
tab:colX0 a owl:DatatypeProperty ; rdfs:domain tab:GridColumn ; rdfs:range xsd:double ; rdfs:label "col x0"@en ;
    rdfs:comment "The column's left boundary (boundaries[i]). With colX1, the half-open [colX0, colX1) that contains a leaf label's ink center determines its column (header-covers.rq; mirrors regions.column_of)."@en .
tab:colX1 a owl:DatatypeProperty ; rdfs:domain tab:GridColumn ; rdfs:range xsd:double ; rdfs:label "col x1"@en ;
    rdfs:comment "The column's right boundary (boundaries[i+1])."@en .
tab:covers a owl:ObjectProperty ; rdfs:domain tab:HeaderCell ; rdfs:range tab:GridColumn ; rdfs:label "covers"@en ;
    rdfs:comment "Derived: a LEAF header cell covers the one grid column whose half-open [colX0, colX1) contains the cell's ink center (tab:inkCenterX) — header-covers.rq. Evidence-positive, no symmetrization."@en .

# --- committed row-role reading evidence (loop C, GrainCorp push) ---
# NOTE: loop B's tab:atHeaderRow / tab:headerText are deliberately NOT reused. Both carry
# rdfs:domain tab:HeaderCell, and region_tiles validates with inference="rdfs", so a committed
# caption bearing them would be INFERRED to be a tab:HeaderCell — contradicting that class's
# "transient … never asserted into a holon" definition and leaking pre-holon evidence vocabulary
# into the compiled holon. Hence dedicated properties.
tab:RegionCaption a owl:Class ; rdfs:label "Region caption"@en ;
    rdfs:comment "Document furniture (a title/date/page line) found inside a table's header region and CARRIED rather than dropped: the NEURAL row-role reading classified its row as furniture. Committed to the holon with its source row, so no source text is ever lost (spec §3.1, CLAUDE.md §5/§7)."@en .
tab:captionText a owl:DatatypeProperty ; rdfs:domain tab:RegionCaption ; rdfs:range rdfs:Literal ; rdfs:label "caption text"@en .
tab:captionRow a owl:DatatypeProperty ; rdfs:domain tab:RegionCaption ; rdfs:range xsd:integer ; rdfs:label "caption row"@en ;
    rdfs:comment "0-based header-region row index the furniture line came from (0 = topmost)."@en .
tab:hasCaption a owl:ObjectProperty ; rdfs:domain tab:Table ; rdfs:range tab:RegionCaption ; rdfs:label "has caption"@en .

tab:HeaderSourceCell a owl:Class ; rdfs:label "Header source cell"@en ;
    rdfs:comment "A committed record of one header-region source cell, region-bound, and the target of tab:HeaderContentConservedShape: every one must be accounted for either inside an asserted header label or as a tab:RegionCaption. Distinct from tab:HeaderCell, which is transient pre-holon covering evidence."@en .
tab:sourceText a owl:DatatypeProperty ; rdfs:domain tab:HeaderSourceCell ; rdfs:range rdfs:Literal ; rdfs:label "source text"@en .
tab:sourceRow a owl:DatatypeProperty ; rdfs:domain tab:HeaderSourceCell ; rdfs:range xsd:integer ; rdfs:label "source row"@en ;
    rdfs:comment "0-based header-region row index the cell came from (0 = topmost)."@en .
tab:hasHeaderSourceCell a owl:ObjectProperty ; rdfs:domain tab:Table ; rdfs:range tab:HeaderSourceCell ; rdfs:label "has header source cell"@en .

# --- header-confirmed boundary evidence (transient, pre-holon; loop G attempt 2) ---
tab:HeaderGlyph a owl:Class ; rdfs:label "Header glyph"@en ;
    rdfs:comment "A transient header-region character's ink x-extent, evidence for the boundary-confirmation derivation (confirm-boundary.rq); never asserted into a holon. CHAR-level on purpose: the real target's leaf header extracts as one word blob that straddles the true boundary at word level and would self-reject."@en .
tab:glyphX0 a owl:DatatypeProperty ; rdfs:domain tab:HeaderGlyph ; rdfs:range xsd:double ; rdfs:label "glyph x0"@en .
tab:glyphX1 a owl:DatatypeProperty ; rdfs:domain tab:HeaderGlyph ; rdfs:range xsd:double ; rdfs:label "glyph x1"@en .
tab:CandidateBoundary a owl:Class ; rdfs:label "Candidate boundary"@en ;
    rdfs:comment "A transient candidate column boundary — an interior gutter the author's rules left out (geometry.refine_rule_columns). CONFIRMED only when header ink lies strictly on both sides within its author interval with no straddling glyph (confirm-boundary.rq); never asserted into a holon."@en .
tab:boundaryX a owl:DatatypeProperty ; rdfs:domain tab:CandidateBoundary ; rdfs:range xsd:double ; rdfs:label "boundary x"@en .
tab:intervalLo a owl:DatatypeProperty ; rdfs:domain tab:CandidateBoundary ; rdfs:range xsd:double ; rdfs:label "interval lo"@en ;
    rdfs:comment "Left edge of the consecutive author-rule interval containing the candidate."@en .
tab:intervalHi a owl:DatatypeProperty ; rdfs:domain tab:CandidateBoundary ; rdfs:range xsd:double ; rdfs:label "interval hi"@en ;
    rdfs:comment "Right edge of that interval."@en .

# --- ruled header-row role evidence (transient, pre-holon; loop L) ---
# The inputs to header-row-role.rq, the header-stack law. Every term is a PRESENCE fact over the
# author's own ruled column grid — emitted by ruledroles.role_evidence, tested there with the
# established COORD_EPS float epsilon so the query itself carries no numeric literal. Transient:
# never asserted into a holon (the committed record of the resulting reading is tab:RegionCaption
# + tab:HeaderSourceCell, as for the loop-C NEURAL reading).
tab:RuledColumn a owl:Class ; rdfs:label "Ruled column"@en ;
    rdfs:comment "A transient column of the band's RULED grid: the author's vertical rules, plus any interior boundary loop G's header confirmation added. NOT purely author-drawn — see ruledroles.grid_is_the_ruled_grid, which states exactly what that set does and does not guarantee. Distinct from tab:GridColumn, the loop-B covering evidence over any leaf grid however recovered."@en .
tab:HeaderRegionRow a owl:Class ; rdfs:label "Header region row"@en ;
    rdfs:comment "A transient NON-LEAF header-region row awaiting its role. The leaf header row is never emitted: it is the leaf by construction, and clause 1 of header-row-role.rq refuses the whole derivation unless it aligns 1:1 with the ruled columns."@en .
tab:headerRowOrder a owl:DatatypeProperty ; rdfs:domain tab:HeaderRegionRow ; rdfs:range xsd:integer ; rdfs:label "header row order"@en ;
    rdfs:comment "0-based header-region row index (0 = topmost), matching rowrole.build_row_reading's role-vector position."@en .
tab:HeaderRegionCell a owl:Class ; rdfs:label "Header region cell"@en ;
    rdfs:comment "A transient cell of a non-leaf header-region row, carrying only its relation to the ruled columns and to the leaf labels."@en .
tab:LeafHeaderCell a owl:Class ; rdfs:label "Leaf header cell"@en ;
    rdfs:comment "A transient cell of the LEAF header row (the deepest header row above the body). Clause 1 of header-row-role.rq reads these to check that every ruled column holds exactly one leaf label; the continuation role reads them as the alignment-origin reference. The leaf row is never given a role."@en .
tab:HeaderBlockRule a owl:Class ; rdfs:label "Header block rule"@en ;
    rdfs:comment "A transient record of an author-drawn HORIZONTAL rule that crosses every interior ruled boundary and lies inside the header region: the author's own statement that the header block starts below it. Positive evidence for the furniture role — ink above such a rule is document furniture, not a header level."@en .
tab:hasHeaderRegionCell a owl:ObjectProperty ; rdfs:domain tab:HeaderRegionRow ; rdfs:range tab:HeaderRegionCell ; rdfs:label "has header region cell"@en .
tab:rowAboveHeaderBlockRule a owl:ObjectProperty ; rdfs:domain tab:HeaderRegionRow ; rdfs:range tab:HeaderBlockRule ; rdfs:label "row above header block rule"@en ;
    rdfs:comment "The row's ink lies wholly above this header-block rule, so the author placed it outside the header block."@en .
tab:rowBelowHeaderBlockRule a owl:ObjectProperty ; rdfs:domain tab:HeaderRegionRow ; rdfs:range tab:HeaderBlockRule ; rdfs:label "row below header block rule"@en ;
    rdfs:comment "The row's ink lies wholly below this header-block rule and above the leaf row, i.e. INSIDE the author's header block. With tab:rowAboveHeaderBlockRule this pair is the engagement context of header-row-role.rq clause 0: the law runs only where one block rule separates a furniture band from a wrapped-label band."@en .
# NOTE (review finding F6): tab:withinRuledColumn is asserted on BOTH tab:HeaderRegionCell and
# tab:LeafHeaderCell subjects, so it carries NO rdfs:domain — an rdfs:domain here would let
# inference (region_tiles validates with inference="rdfs") type every leaf cell as a
# HeaderRegionCell, contradicting both class definitions.
tab:withinRuledColumn a owl:ObjectProperty ; rdfs:range tab:RuledColumn ; rdfs:label "within ruled column"@en ;
    rdfs:comment "The cell's ink lies STRICTLY inside this ruled column, reaching neither boundary (ruledroles._within — deliberately stricter than regions._word_in_column, which asks whether a word FITS; see that docstring). Asserted on both tab:HeaderRegionCell and tab:LeafHeaderCell, hence no rdfs:domain."@en .
tab:sharesAlignmentOriginWith a owl:ObjectProperty ; rdfs:domain tab:HeaderRegionCell ; rdfs:range tab:LeafHeaderCell ; rdfs:label "shares alignment origin with"@en ;
    rdfs:comment "The cell's ink shares a left or right edge exactly with this leaf header cell (ruledroles._shares_origin). Wrapped lines of ONE table cell are laid out from that cell's own origin, so a shared origin is positive evidence that the two are lines of one cell — the renderer's accommodation read back. An equality with COORD_EPS as the float epsilon, never a proximity window."@en .

# --- detected aggregation rows (loop H, residue R4) ---
tab:DetectedAggregationRow a owl:Class ; rdfs:subClassOf tab:AggregationRow ;
    rdfs:label "Detected aggregation row"@en ;
    rdfs:comment "An aggregation row DETECTED by exact arithmetic in the extraction path (loop H): a sparse body row whose measure equals the token-sum of its member rows. Distinct subclass on purpose: denormalization's reshape path types rows bare tab:AggregationRow without row-level operands, and the operand-requiring shape must not fire on those. Detection never reads label text — sparsity, label column and arithmetic only."@en .

# --- derived row groups (loop I) ---
tab:DerivedRowGroup a owl:Class ;
    rdfs:subClassOf tab:HeaderNode ;
    rdfs:label "derived row group"@en ;
    rdfs:comment "A row-group header node DERIVED from a confirmed aggregation row (loop I): its coversRow members come from the aggregation's operands, its label from the unique non-blank member value in the label column, its provenance from the witnessing aggregation row. Derived groups are carried annotations over the row axis — coverage may be PARTIAL (rows of unconfirmed groups stay uncovered), so the row-tiling shapes exclude derived-only trees; tab:DerivedRowGroupShape guards well-formedness instead."@en .

# --- pagination: continuation chains + repeated headers (loop M) ---
# A paginated table is ONE logical table the renderer split across page breaks — an
# accommodation to the page, not a structure the author intended. These two terms are the
# COMMITTED record of un-doing it: the link between the page-tables, and the repeated header
# block carried as a fact rather than read as data (CLAUDE.md §5/§7 — never dropped, never
# mistaken for a body row).
tab:continuesTable a owl:ObjectProperty ; rdfs:label "continues table"@en ;
    rdfs:domain tab:Table ; rdfs:range tab:Table ;
    rdfs:comment "This table is the CONTINUATION of that one across a page break: the same logical table, resumed. Asserted only when the continuation-of.rq derivation licensed it from the two pages' repeated header blocks (identical leaf labels, column for column, at agreeing origins, over author-drawn column boundaries agreeing AS SETS under COORD_EPS) — never assumed from page adjacency. KNOWN LIMIT, stated where the term is defined (residue R33): the evidence is the repeated HEADER BLOCK, which two logically INDEPENDENT tables built from one template share exactly — measured, a 2-page template document with different data on each page is stitched. This is the taxonomy case-2 / case-3 boundary (spec §2b defers case 3): the property means 'the header block repeats and the grid matches', which is necessary but not sufficient for 'one table'. The available discriminator is the BODY side (does the earlier table run to its page's last text line?), not text reading."@en .
tab:RepeatedHeader a owl:Class ; rdfs:label "Repeated header"@en ;
    rdfs:comment "A header block REPEATED on a continuation page: the renderer redrew the head table's header so the split page could be read standalone. Carried as a fact with its own page and bbox provenance — it is neither a second header tree nor a body row. ONE node per repeated ROW (the leaf row included — it is the most repeated row of all), carrying: tab:cellText, the row's surface text in reading order; tab:onPage and tab:hasBBox, measured on the continuation page; and prov:wasDerivedFrom, pointing at the tab:HeaderSourceCell nodes of the ORIGINATING (head) page's row it repeats — pinned to the head page even three pages down the chain, so the trail never degenerates into page-to-page hearsay. A repeated header row is never a tab:EntryCell: the carried reading reads it as a header row, so it can never reach the body."@en .
tab:hasRepeatedHeader a owl:ObjectProperty ; rdfs:domain tab:Table ; rdfs:range tab:RepeatedHeader ;
    rdfs:label "has repeated header"@en ;
    rdfs:comment "Links a continuation-page table to one row of the header block redrawn on its page. Present only on tables whose reading was CARRIED from the page before under a licensed continuation (see tab:continuesTable); a head table has none."@en .
# --- the column half of the same link, and its closure (loop N) ---
tab:continuesColumn a owl:ObjectProperty ; rdfs:label "continues column"@en ;
    rdfs:domain tab:LeafColumn ; rdfs:range tab:LeafColumn ;
    rdfs:comment "This leaf column of a continuation table is the SAME logical column as that one of the table it continues. Asserted exactly where tab:continuesTable is, and licensed by the SAME derivation, clauses (b)+(c) of continuation-of.rq: every column of page N-1's leaf header row has a counterpart at the same column index on page N carrying the same text at an agreeing ink origin, and no column of page N's is left without one — a bijection AT EQUAL INDEX, which is what makes 'column 17 here' and 'column 17 there' one column. Never inferred from column count or position alone. WHY IT IS COMMITTED rather than left implicit: a consumer that must recognize one logical column across the break (the document-level row-group key, the feed's group-key injection) would otherwise have to parse the minting convention out of the column IRIs — reading structure out of names instead of out of the graph. This term states the PAIRWISE fact only — what the law licensed for the one page pair it was asserted from. Its reflexive-transitive closure over a chain is tab:inLogicalColumn, which is what consumers read. INHERITS tab:continuesTable's known limit (residue R33): the link means the header block repeats and the grid matches, which is necessary but not sufficient for 'one table'."@en .
tab:inLogicalColumn a owl:ObjectProperty ; rdfs:label "in logical column"@en ;
    rdfs:domain tab:LeafColumn ; rdfs:range tab:LeafColumn ;
    rdfs:comment "This leaf column is part of the LOGICAL column canonically named by that one — the chain's HEAD table's column at the same index. It is exactly the reflexive-transitive closure of tab:continuesColumn, MATERIALIZED ONLY FOR COLUMNS THAT ACTUALLY PARTICIPATE IN A CHAIN (loop N task 4 review — the phrasing below was corrected because a reader could take it as a totality claim, which it is not, and a SHACL shape asserting minCount 1 over every tab:LeafColumn would therefore be WRONG): reflexive at the head — once a chain exists, the head's own column trivially is part of its own logical column (the head's columns point at themselves, which is what lets one triple pattern reach a head cell and a continuation cell alike) — and transitive down the chain, because a column three pages down is part of the same logical column as the head's. An UNCHAINED column (one whose table never appears on either side of tab:continuesTable) carries NO tab:inLogicalColumn triple at all, reflexive or otherwise — that absence is the correct, honest state for a table nothing ever continued, not a gap for inference or a cardinality shape to close. (feed._logical_column treats that absence as a READING convention — no link means the column is its own logical column — never as an asserted graph fact; see there.) Materialized by document._link_columns as each licensed pair is stitched — asserted, not entailed at read time, because iladub is reasoner-free and because the alternative (a tab:continuesColumn* property path inside the row-group key derivation) was MEASURED at 21 s for one 94-member witness against 0.26 s for this one-hop form on the same graph (loop N review). Every fact it states is licensed by the tab:continuesColumn edges it closes over and by nothing else; it adds no reach the pairwise edges did not already carry."@en .

# --- continuation recognition evidence (transient, pre-holon; loop M) ---
# The inputs to continuation-of.rq. Every term is a PRESENCE or EQUALITY fact about the two
# pages' leaf header rows and the author's drawn column boundaries — emitted by
# document.continuation_evidence with the established COORD_EPS float epsilon applied AT
# EMISSION, so the query itself carries no numeric literal. Transient: never asserted into a
# holon (the committed record is tab:continuesTable + tab:RepeatedHeader above).
tab:PriorPageBlock a owl:Class ; rdfs:label "Prior page block"@en ;
    rdfs:comment "A transient node standing for the leaf header block of page N-1's table — the side of the comparison a continuation would continue."@en .
tab:ContinuationPageBlock a owl:Class ; rdfs:label "Continuation page block"@en ;
    rdfs:comment "A transient node standing for the leaf header block of page N's candidate table — the side under test."@en .
tab:PageLeafCell a owl:Class ; rdfs:label "Page leaf cell"@en ;
    rdfs:comment "A transient cell of one page's LEAF header row, carrying its ruled-column index, its exact surface text and its ink origin. Comparing these across a page break is evidence comparison (are these two renderings the same header?), not text READING — no meaning is drawn from the strings."@en .
# NOTE (loop L review finding F6, applied again): tab:hasLeafCell / tab:hasAuthorBoundary are
# asserted on BOTH block classes, so neither carries an rdfs:domain — an rdfs:domain would let
# inference type every continuation block as a prior block and collapse the two sides.
tab:hasLeafCell a owl:ObjectProperty ; rdfs:range tab:PageLeafCell ; rdfs:label "has leaf cell"@en ;
    rdfs:comment "Links a page block to one cell of its leaf header row. Asserted on both tab:PriorPageBlock and tab:ContinuationPageBlock, hence no rdfs:domain."@en .
tab:leafColumnIndex a owl:DatatypeProperty ; rdfs:domain tab:PageLeafCell ; rdfs:range xsd:integer ;
    rdfs:label "leaf column index"@en ;
    rdfs:comment "0-based index of the ruled column the cell's ink center falls in (regions.column_of over the page's own leaf grid). The join key of the column-for-column comparison."@en .
tab:leafCellText a owl:DatatypeProperty ; rdfs:domain tab:PageLeafCell ; rdfs:range rdfs:Literal ;
    rdfs:label "leaf cell text"@en ;
    rdfs:comment "The cell's exact surface text. Compared by literal identity in continuation-of.rq — no normalisation, no fuzzy match: a partial match is NOT a continuation."@en .
tab:leafOriginX a owl:DatatypeProperty ; rdfs:domain tab:PageLeafCell ; rdfs:range xsd:double ;
    rdfs:label "leaf origin x"@en ;
    rdfs:comment "The cell's ink origin (x0), carried so the evidence graph is auditable. The query never compares it: the COORD_EPS equality is applied at emission and surfaces as tab:originAgreesWith."@en .
tab:originAgreesWith a owl:ObjectProperty ; rdfs:domain tab:PageLeafCell ; rdfs:range tab:PageLeafCell ;
    rdfs:label "origin agrees with"@en ;
    rdfs:comment "The two cells' ink origins are EQUAL under COORD_EPS, the repo's float-comparison epsilon (never a proximity window). The same laid-out position on two pages is the renderer repeating one header block."@en .
tab:AuthorRuledBoundary a owl:Class ; rdfs:label "Author ruled boundary"@en ;
    rdfs:comment "A transient record of one leaf-grid column boundary the AUTHOR actually DREW (a vertical rule of the band). Deliberately EXCLUDES loop-G header-confirmed boundaries: those are inferred from THIS page's ink — one of the specimen's two is measured to move across the break, and the other agrees only by coincidence of this document's ink — so neither is evidence about the author's grid. The restriction also makes the clause immune to R32: a fabricated boundary carries no rule, so it can never enter it. See continuation-of.rq's header for the measurement."@en .
tab:hasAuthorBoundary a owl:ObjectProperty ; rdfs:range tab:AuthorRuledBoundary ;
    rdfs:label "has author boundary"@en ;
    rdfs:comment "Links a page block to one author-drawn boundary of its leaf grid. Asserted on both block classes, hence no rdfs:domain."@en .
tab:ruledBoundaryX a owl:DatatypeProperty ; rdfs:domain tab:AuthorRuledBoundary ; rdfs:range xsd:double ;
    rdfs:label "ruled boundary x"@en ;
    rdfs:comment "The boundary's x, carried for auditability only; the query compares it solely through tab:boundaryAgreesWith."@en .
tab:boundaryAgreesWith a owl:ObjectProperty ; rdfs:domain tab:AuthorRuledBoundary ; rdfs:range tab:AuthorRuledBoundary ;
    rdfs:label "boundary agrees with"@en ;
    rdfs:comment "The two author-drawn boundaries are EQUAL under COORD_EPS — the two pages are ruled on the same grid. Clause (d) of continuation-of.rq reads these SET-WISE (every boundary on each side needs some agreeing counterpart on the other), not one-for-one: a border the author drew twice at the same x is one mark, and must not refuse a genuine continuation."@en .

# --- continuation LICENCE evidence (transient, pre-holon; loop O, residue R33) ---
# The inputs to continuation-licence.rq — the SECOND question about a page pair, asked only of a
# pair continuation-of.rq already recognized: the header block repeating says the two pages share
# a TEMPLATE; these terms say whether what the renderer drew AROUND the table is page furniture
# (one document, cut) or new content (two documents). Every term is a PRESENCE fact about a
# non-table text block — no coordinate is ever compared in the query, and no meaning is ever drawn
# from a block's text: comparing two renderings of one string for identity is evidence comparison,
# not text READING (continuation-of.rq's header states the distinction in full). Transient: never
# asserted into a holon.
tab:ContinuationPairUnderTest a owl:Class ; rdfs:label "Continuation pair under test"@en ;
    rdfs:comment "A transient node standing for the ONE recognized page pair (N-1, N) whose licence is being decided — the closure boundary of the derivation, and the subject continuation-licence.rq returns when the law holds. Its block inventory is the whole evidence: a pair with no blocks at all meets the law vacuously and IS licensed (two bare tables on consecutive pages are read as one table by a fluent reader; the law refuses on marks and never invents one)."@en .
tab:PriorPageTextBlock a owl:Class ; rdfs:label "Prior page text block"@en ;
    rdfs:comment "A transient node standing for one NON-TABLE text block of page N-1 — a band the page carries outside the recognized table (running head, title, timestamp, footer). Only those additionally typed tab:BelowTableBodyBlock are constrained by the law; the rest are the head-side furniture a first page legitimately draws once."@en .
tab:ContinuationPageTextBlock a owl:Class ; rdfs:label "Continuation page text block"@en ;
    rdfs:comment "A transient node standing for one NON-TABLE text block of page N, the page under test."@en .
tab:BelowTableBodyBlock a owl:Class ; rdfs:label "Below-table-body block"@en ;
    rdfs:comment "The block sits BELOW its page's table — after that table's last body row. Emitted as a positional fact about a prior-page block, not as a requirement: clause (b) of continuation-licence.rq is what turns it into one (whatever page N-1 drew after its table must reappear on page N, or its table was not cut by the page edge). Absence of this type on a prior block is the head side's freedom, expressed as a pattern the clause cannot reach."@en .
tab:OutsideRepeatedHeaderBlock a owl:Class ; rdfs:label "Outside-repeated-header block"@en ;
    rdfs:comment "The block lies OUTSIDE the repeated header block the continuation page redrew — i.e. outside the recognized table band entirely, which is where every non-table band of that page sits by construction (bands do not overlap). Emitted on continuation-page blocks; clause (a) constrains exactly these."@en .
tab:hasPageBlock a owl:ObjectProperty ; rdfs:domain tab:ContinuationPairUnderTest ;
    rdfs:label "has page block"@en ;
    rdfs:comment "Links the pair under test to one non-table text block of either of its two pages. Which page the block belongs to is carried by the block's own type (tab:PriorPageTextBlock / tab:ContinuationPageTextBlock), never by this property, so the two sides can never collapse."@en .
tab:blockText a owl:DatatypeProperty ; rdfs:range rdfs:Literal ; rdfs:label "block text"@en ;
    rdfs:comment "The block's exact surface text, its lines in reading order. Compared by literal identity across the page break and by nothing else — no normalisation, no fuzzy match, no meaning. Asserted on both block classes, hence no rdfs:domain (the loop-L F6 finding: an rdfs:domain here would let inference type every continuation block as a prior block)."@en .
